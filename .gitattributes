# Normalise line endings across platforms.
# LF in the repo; checkouts use LF too (git tracks the canonical form).
* text=auto eol=lf

# Binary files never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
*.mov binary
*.pdf binary
*.zip binary
