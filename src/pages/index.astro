---
import Site from '../layouts/Site.astro';
import SiteNav from '../components/common/SiteNav.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import { site } from '../site.config';
const unfilled = !site.name;
---
<Site title={site.title || 'Yonah Website Engine'} description={site.description || 'A toolkit base for building client sites.'} family={site.family}>
  {site.nav.length > 0 && <SiteNav />}
  <main class="min-h-screen flex items-center justify-center">
    <div class="container-site max-w-2xl text-center py-32">
      <h1 class="text-5xl md:text-6xl leading-tight">Starter page</h1>
      <p class="mt-6 text-lg text-[var(--color-muted-fg,#666)]">
        {unfilled
          ? 'This is the blank starter page for a new site. Edit src/site.config.ts, then replace this file in src/pages/index.astro with your own content.'
          : `Welcome to ${site.name}. Replace src/pages/index.astro with your own content.`}
      </p>
      <p class="mt-4 text-sm text-[var(--color-muted-fg,#999)]">
        See src/pages/_examples/ for working demo pages, and CLAUDE.md for how the base is laid out.
      </p>
    </div>
  </main>
  <SiteFooter variant="simple" />
</Site>
