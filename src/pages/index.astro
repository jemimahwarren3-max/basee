---
import Base from '../layouts/Base.astro';
---
<Base title="Yonah Website Engine" description="Premium website production base — 162 components, 20 design families">
  <main class="min-h-screen flex items-center justify-center bg-[var(--color-bg,#fff)]">
    <div class="container-site text-center py-32">
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-tight">Yonah Website Engine</h1>
      <p class="mt-6 text-xl text-[var(--color-muted-fg,#666)] max-w-2xl mx-auto">162 production-ready components across 15 categories, powered by 20 design families. Clone, prompt, build.</p>
      <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 max-w-3xl mx-auto text-sm">
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">20</span>Heroes</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">16</span>Services</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">12</span>Galleries</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">22</span>Interactive</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">10</span>Navigation</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">12</span>About</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">10</span>Footers</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">8</span>Testimonials</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">8</span>Contact</div>
        <div class="bg-[var(--color-surface,#f5f5f5)] rounded-lg p-4"><span class="block text-2xl font-bold">41+</span>More</div>
      </div>
      <p class="mt-16 text-sm text-[var(--color-muted-fg,#999)]">Clone this repo → open in Claude Code → describe your website → get a production site in minutes.</p>
    </div>
  </main>
</Base>
