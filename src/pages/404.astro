---
import Site from '../layouts/Site.astro';
import SiteNav from '../components/common/SiteNav.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import { site } from '../site.config';
---

<Site title="Not found" description="This page doesn't exist." family={site.family} noindex={true}>
  {site.nav.length > 0 && <SiteNav />}
  <main class="min-h-[70vh] flex items-center justify-center">
    <div class="container-site max-w-xl text-center py-32">
      <p class="text-xs uppercase tracking-widest text-[var(--color-muted-fg,#999)]">404</p>
      <h1 class="mt-4 text-5xl md:text-6xl leading-tight">Page not found</h1>
      <p class="mt-6 text-lg text-[var(--color-muted-fg,#666)]">
        The page you were looking for doesn't exist or has moved.
      </p>
      <a
        href="/"
        class="mt-10 inline-block px-6 py-3 bg-[var(--color-fg,#111)] text-[var(--color-bg,#fff)] text-sm font-medium"
      >
        Back to home
      </a>
    </div>
  </main>
  <SiteFooter />
</Site>
