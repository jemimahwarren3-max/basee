---
import Site from '../../layouts/Site.astro';
import SiteNav from '../../components/common/SiteNav.astro';
import SiteFooter from '../../components/common/SiteFooter.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) => !data.draft);
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: sorted[(i + 1) % sorted.length] },
  }));
}

interface Props {
  project: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { project, next } = Astro.props;
const { Content } = await render(project);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  creator: project.data.client ? { '@type': 'Organization', name: project.data.client } : undefined,
  dateCreated: project.data.year ? String(project.data.year) : undefined,
};
---

<Site
  title={`${project.data.title} — ${site.name || 'Work'}`}
  description={project.data.description}
  family={site.family}
  image={project.data.cover || `/og/work/${project.id}.png`}
  ogType="article"
  structuredData={structuredData}
>
  {site.nav.length > 0 && <SiteNav />}
  <main>
    <section class="container-site pt-24 md:pt-32 max-w-4xl">
      <a
        href="/work"
        class="text-xs uppercase tracking-widest text-[var(--color-muted-fg,#999)] hover:opacity-70"
      >
        ← Work
      </a>
      <div class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-2">
        {project.data.client && (
          <p class="text-sm text-[var(--color-muted-fg,#666)]">{project.data.client}</p>
        )}
        {project.data.year && (
          <p class="text-sm text-[var(--color-muted-fg,#666)] tabular-nums">{project.data.year}</p>
        )}
        {project.data.role && (
          <p class="text-sm text-[var(--color-muted-fg,#666)]">{project.data.role}</p>
        )}
      </div>
      <h1 class="mt-3 text-4xl md:text-6xl leading-[1.05]">{project.data.title}</h1>
      <p class="mt-6 text-xl text-[var(--color-muted-fg,#666)] max-w-2xl leading-relaxed">
        {project.data.description}
      </p>
      {project.data.url && (
        <a
          href={project.data.url}
          class="mt-6 inline-block text-sm underline hover:opacity-70"
          target="_blank"
          rel="noopener"
        >
          Visit site ↗
        </a>
      )}
    </section>

    {project.data.cover && (
      <section class="container-site mt-16 md:mt-20 max-w-5xl">
        <img
          src={project.data.cover}
          alt={project.data.title}
          class="w-full aspect-[16/10] object-cover"
        />
      </section>
    )}

    <article class="container-site mt-16 md:mt-24 max-w-2xl prose">
      <Content />
    </article>

    {project.data.gallery.length > 0 && (
      <section class="container-site mt-16 md:mt-24 max-w-5xl space-y-8">
        {project.data.gallery.map((src) => (
          <img src={src} alt="" class="w-full" loading="lazy" />
        ))}
      </section>
    )}

    <section class="container-site mt-24 md:mt-32 mb-16 max-w-4xl border-t border-[var(--color-border,#e5e5e5)] pt-8">
      <a href={`/work/${next.id}`} class="group block">
        <p class="text-xs uppercase tracking-widest text-[var(--color-muted-fg,#999)]">
          Next project →
        </p>
        <p class="mt-2 text-2xl md:text-3xl group-hover:opacity-70 transition-opacity">
          {next.data.title}
        </p>
      </a>
    </section>
  </main>
  <SiteFooter />
</Site>
