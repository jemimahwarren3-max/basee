---
import Site from '../layouts/Site.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { site } from '../site.config';
import { enquiryAction } from '../lib/forms';
---
<Site title={`Contact — ${site.name || 'Site'}`} description={site.description} family={site.family}>
  <main>
    <ContactForm
      title="Get in touch"
      subtitle={site.name ? `Send ${site.name} a message.` : 'Send us a message.'}
      fields={['name', 'email', 'subject', 'message']}
      submitLabel="Send message"
      action={enquiryAction()}
    />
  </main>
</Site>
