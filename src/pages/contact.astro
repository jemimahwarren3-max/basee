---
import Site from '../layouts/Site.astro';
import SiteNav from '../components/common/SiteNav.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { site } from '../site.config';
import { enquiryAction } from '../lib/forms';
---

<Site
  title={`Contact — ${site.name || 'Site'}`}
  description={site.description}
  family={site.family}
>
  {site.nav.length > 0 && <SiteNav />}
  <main>
    <section class="container-site pt-24 md:pt-32">
      <h1 class="text-4xl md:text-5xl leading-tight">Contact</h1>
    </section>
    <ContactForm
      title="Get in touch"
      subtitle={site.name ? `Send ${site.name} a message.` : 'Send us a message.'}
      fields={['name', 'email', 'subject', 'message']}
      submitLabel="Send message"
      action={enquiryAction()}
    />
  </main>
  <SiteFooter />
</Site>
