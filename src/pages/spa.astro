---
import Spa from '../layouts/Spa.astro';
import NavCentered from '../components/navigation/NavCentered.astro';
import HeroCinematic from '../components/heroes/HeroCinematic.astro';
import Marquee from '../components/interactive/Marquee.astro';
import AboutSideBySide from '../components/about/AboutSideBySide.astro';
import ServicesHover from '../components/services/ServicesHover.astro';
import ServicesPricing from '../components/services/ServicesPricing.astro';
import GalleryFullwidth from '../components/galleries/GalleryFullwidth.astro';
import TestimonialQuote from '../components/testimonials/TestimonialQuote.astro';
import TestimonialGrid from '../components/testimonials/TestimonialGrid.astro';
import BookingEnquiry from '../components/interactive/BookingEnquiry.astro';
import StepsProcess from '../components/interactive/StepsProcess.astro';
import CtaFullscreen from '../components/cta/CtaFullscreen.astro';
import FaqAccordion from '../components/faq/FaqAccordion.astro';
import ContactWhatsApp from '../components/contact/ContactWhatsApp.astro';
import FooterFull from '../components/footers/FooterFull.astro';
import AnnouncementBar from '../components/interactive/AnnouncementBar.astro';
import BackToTop from '../components/interactive/BackToTop.astro';
import CookieBanner from '../components/interactive/CookieBanner.astro';
import SmoothScroll from '../components/effects/SmoothScroll.astro';
import TextMask from '../components/effects/TextMask.astro';
---
<Spa title="Serenité Spa — Luxury Wellness & Beauty" description="Escape into tranquility. Bespoke spa treatments, therapeutic massage, and holistic wellness in the heart of the city.">

  <AnnouncementBar text="New guest offer: 20% off your first treatment — Book today" href="#booking" />

  <NavCentered
    brand="Serenité"
    links={[
      { label: 'Treatments', href: '#treatments' },
      { label: 'Experience', href: '#experience' },
      { label: 'Gallery', href: '#gallery' },
      { label: 'Pricing', href: '#pricing' },
      { label: 'Reviews', href: '#reviews' },
      { label: 'FAQ', href: '#faq' },
    ]}
    cta={{ label: 'Book Now', href: '#booking' }}
  />

  <HeroCinematic
    image="https://images.unsplash.com/photo-1540555700478-4be289fbec6d?w=2000&h=1300&fit=crop"
    title="Where stillness<br />meets luxury"
    subtitle="Escape the everyday. Bespoke treatments that blend ancient healing traditions with modern luxury."
    cta={{ label: 'Book your escape', href: '#booking' }}
    align="bottom-left"
  />

  <Marquee
    items={['Therapeutic Massage', 'Facial Treatments', 'Body Wraps', 'Aromatherapy', 'Hot Stone Therapy', 'Couples Rituals', 'Wellness Packages']}
    speed="slow"
    separator="·"
  />

  <TextMask
    text="SERENITÉ"
    image="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=1600&h=900&fit=crop"
    fontSize="18vw"
  />

  <div id="experience">
    <AboutSideBySide
      title="A sanctuary crafted for you"
      content="Nestled in a restored heritage building, Serenité is a haven of calm in the heart of the city. Every detail, from the hand-blended oils to the heated marble treatment beds, is chosen to make the ordinary feel like a ritual."
      image="https://images.unsplash.com/photo-1600334089648-b0d9d3028eb2?w=800&h=1000&fit=crop"
      imageLeft={true}
      stats={[
        { value: '[Years]', label: 'Years of practice' },
        { value: '[Count]', label: 'Expert therapists' },
        { value: '[Rating]', label: 'Guest rating' },
        { value: '[Count]', label: 'Guests treated' },
      ]}
    />
  </div>

  <div id="treatments">
    <ServicesHover
      title="Signature treatments"
      services={[
        { title: 'Signature Massage', description: 'A bespoke 90-minute full-body journey with warm botanical oils.', image: 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=600&h=400&fit=crop' },
        { title: 'Gold Radiance Facial', description: 'Luxury anti-aging facial with 24K gold-infused serums and microcurrent lifting.', image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=600&h=400&fit=crop' },
        { title: 'Warm Stone Ritual', description: 'Heated basalt stones along the energy meridians, paired with aromatic oils.', image: 'https://images.unsplash.com/photo-1596178060671-7a80dc8059ea?w=600&h=400&fit=crop' },
        { title: 'Couples Harmony', description: 'Side-by-side treatments in a private suite, with champagne and an aromatherapy bath.', image: 'https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=600&h=400&fit=crop' },
        { title: 'Ayurvedic Body Wrap', description: 'Detoxifying herbal wrap with turmeric, sandalwood and neem.', image: 'https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=600&h=400&fit=crop' },
        { title: 'Japanese Head Spa', description: 'Scalp therapy combining deep cleansing, acupressure and botanical nourishment.', image: 'https://images.unsplash.com/photo-1600334129128-685c5582fd35?w=600&h=400&fit=crop' },
      ]}
    />
  </div>

  <TestimonialQuote
    quote="[A guest quote goes here, once the client supplies a real one.]"
    author="[Guest name]"
    role="[Role or context]"
    large={true}
  />

  <div id="gallery">
    <GalleryFullwidth
      images={[
        { src: 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=1200&h=800&fit=crop', alt: 'Massage treatment room' },
        { src: 'https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1200&h=800&fit=crop', alt: 'Essential oils and candles' },
        { src: 'https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=1200&h=800&fit=crop', alt: 'Relaxation pool' },
        { src: 'https://images.unsplash.com/photo-1600334129128-685c5582fd35?w=1200&h=800&fit=crop', alt: 'Facial treatment' },
        { src: 'https://images.unsplash.com/photo-1519823551278-64ac92734fb1?w=1200&h=800&fit=crop', alt: 'Spa interior' },
        { src: 'https://images.unsplash.com/photo-1596178060671-7a80dc8059ea?w=1200&h=800&fit=crop', alt: 'Hot stones' },
      ]}
    />
  </div>

  <div id="pricing">
    <ServicesPricing
      title="Treatment menu"
      services={[
        { title: 'Classic Relaxation Massage', description: '60 minutes of full-body relaxation', price: '[Price]', unit: 'session', features: ['Hot towel service', 'Aromatherapy blend', 'Herbal tea ritual'] },
        { title: 'Signature Massage', description: 'Our bespoke 90-minute signature treatment', price: '[Price]', unit: 'session', features: ['Personal consultation', 'Custom oil blend', 'Relaxation lounge'] },
        { title: 'Gold Radiance Facial', description: '75-minute luxury facial with 24K gold serums', price: '[Price]', unit: 'session', features: ['Skin analysis', 'Microcurrent lifting', 'Take-home serum'] },
        { title: 'Couples Harmony', description: 'Two-hour shared experience in a private suite', price: '[Price]', unit: 'couple', features: ['Private suite', 'Champagne & treats', 'Aromatherapy bath'] },
      ]}
    />
  </div>

  <StepsProcess
    title="Your visit"
    subtitle="From the moment you arrive, every detail is taken care of."
    steps={[
      { number: '01', title: 'Book', description: 'Choose your treatment and time online or on WhatsApp.' },
      { number: '02', title: 'Arrive', description: 'Settle into the relaxation lounge with herbal tea and heated robes.' },
      { number: '03', title: 'Consult', description: 'Your therapist learns your needs and preferences before you begin.' },
      { number: '04', title: 'Unwind', description: 'Surrender to your treatment, then linger in the recovery lounge.' },
    ]}
  />

  <div id="reviews">
    <TestimonialGrid
      title="What our guests say"
      testimonials={[
        { quote: '[Real guest review 1]', name: '[Guest name]', role: '[Context]' },
        { quote: '[Real guest review 2]', name: '[Guest name]', role: '[Context]' },
        { quote: '[Real guest review 3]', name: '[Guest name]', role: '[Context]' },
      ]}
    />
  </div>

  <CtaFullscreen
    title="Gift the experience of luxury"
    subtitle="A Serenité gift voucher, in any amount or as a curated treatment package."
    image="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1800&h=1000&fit=crop"
    cta={{ label: 'Buy a gift voucher', href: '#booking' }}
    secondaryCta={{ label: 'View the menu', href: '#pricing' }}
  />

  <div id="faq">
    <FaqAccordion
      title="Frequently asked questions"
      items={[
        { question: 'What should I wear?', answer: 'Plush robes, slippers and disposable undergarments are provided. Just bring yourself.' },
        { question: 'How far ahead should I book?', answer: '[Client to confirm booking lead time.]' },
        { question: 'Is there parking?', answer: '[Client to confirm parking details.]' },
        { question: 'Can I request a specific therapist?', answer: 'Yes. Select your preferred therapist when booking.' },
        { question: 'What is your cancellation policy?', answer: '[Client to confirm cancellation policy.]' },
      ]}
    />
  </div>

  <div id="booking">
    <BookingEnquiry
      title="Book your treatment"
      subtitle="Reserve your time of stillness."
      whatsapp="[WhatsApp number]"
      fields={[
        { name: 'name', label: 'Full name', type: 'text', required: true },
        { name: 'email', label: 'Email', type: 'email', required: true },
        { name: 'phone', label: 'Phone', type: 'tel', required: true },
        { name: 'treatment', label: 'Treatment', type: 'select', required: true, options: ['Classic Relaxation Massage', 'Signature Massage', 'Gold Radiance Facial', 'Couples Harmony', 'Ayurvedic Body Wrap', 'Japanese Head Spa'] },
        { name: 'date', label: 'Preferred date', type: 'date', required: true },
        { name: 'notes', label: 'Special requests', type: 'textarea', required: false },
      ]}
    />
  </div>

  <ContactWhatsApp
    title="Prefer to chat?"
    subtitle="Message us on WhatsApp for quick bookings and questions."
    whatsapp="[WhatsApp number]"
    message="Hello, I'd like to book a treatment."
  />

  <FooterFull
    brand="Serenité Spa"
    description="A luxury wellness destination. Bespoke treatments and an unwavering commitment to your wellbeing."
    columns={[
      { title: 'Treatments', links: [
        { label: 'Massage', href: '#treatments' },
        { label: 'Facials', href: '#treatments' },
        { label: 'Couples', href: '#treatments' },
        { label: 'Gift vouchers', href: '#booking' },
      ]},
      { title: 'Visit', links: [
        { label: 'About', href: '#experience' },
        { label: 'Menu', href: '#pricing' },
        { label: 'FAQ', href: '#faq' },
        { label: 'Book', href: '#booking' },
      ]},
      { title: 'Contact', links: [
        { label: '[Address]', href: '#' },
        { label: '[Email]', href: '#' },
        { label: '[Phone]', href: '#' },
      ]},
    ]}
    copyright="© Serenité Spa. All rights reserved."
  />

  <BackToTop />
  <CookieBanner />
  <SmoothScroll />

</Spa>
