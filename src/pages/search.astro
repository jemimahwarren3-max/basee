---
// Client-side search over the whole site, powered by Pagefind.
//
// Pagefind runs after `astro build` and indexes everything under /dist.
// To tune what's searchable, add data-pagefind-body / data-pagefind-ignore
// attributes to your layouts and components. See https://pagefind.app
import Site from '../layouts/Site.astro';
import SiteNav from '../components/common/SiteNav.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import { site } from '../site.config';
---

<Site
  title={`Search — ${site.name || 'Site'}`}
  description="Search across the site."
  family={site.family}
  noindex={true}
>
  {site.nav.length > 0 && <SiteNav />}
  <main id="main" class="container-site py-24 md:py-32 max-w-3xl">
    <h1 class="text-4xl md:text-5xl leading-tight">Search</h1>
    <p class="mt-4 text-[var(--color-muted-fg,#666)]">
      Type to search across pages, journal posts, work and events.
    </p>
    <div id="search" class="mt-8"></div>
    <p class="mt-4 text-xs text-[var(--color-muted-fg,#999)]">
      The search index is produced at build time. It won't work in `npm run dev`; use `npm run build
      && npm run preview` to try it locally.
    </p>
  </main>
  <SiteFooter />
</Site>

<link
  rel="stylesheet"
  href="/pagefind/pagefind-ui.css"
  onerror="this.replaceWith(Object.assign(document.createElement('div'),{textContent:'(Search index not yet built — run npm run build.)',style:'color:#999'}))"
/>
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({ element: '#search', showImages: false });
    }
  });
</script>
