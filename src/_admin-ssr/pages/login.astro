---
// Admin login. Posts to /admin/login (same route, handled by the endpoint
// below) which sets a signed session cookie.
//
// Works in Astro server mode only. In static mode, this page renders but the
// form POST isn't handled.
export const prerender = false;

import { passwordMatches, makeSessionCookie } from '../../lib/auth';

let error: string | null = null;
let nextPath = '/admin/';
try {
  const url = new URL(Astro.request.url);
  nextPath = url.searchParams.get('next') || '/admin/';
} catch {}

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const password = (form.get('password') ?? '').toString();
    const next = (form.get('next') ?? '/admin/').toString();
    if (passwordMatches(password)) {
      Astro.response.headers.append('Set-Cookie', makeSessionCookie());
      return Astro.redirect(next);
    }
    error = 'Wrong password.';
  } catch {
    error = 'Something went wrong. Try again.';
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin login</title>
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0b0b0d; color: #f4f4f5; }
      form { width: 100%; max-width: 20rem; padding: 2rem; }
      h1 { margin: 0 0 1rem; font-size: 1.5rem; font-weight: 600; }
      label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.6); margin-bottom: 0.5rem; }
      input { width: 100%; padding: 0.75rem 1rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: inherit; border-radius: 0.375rem; box-sizing: border-box; font-size: 0.875rem; }
      input:focus { outline: none; border-color: rgba(255,255,255,0.6); }
      button { width: 100%; padding: 0.75rem 1rem; margin-top: 1rem; background: white; color: #0b0b0d; border: 0; border-radius: 0.375rem; font-weight: 500; font-size: 0.875rem; cursor: pointer; }
      .error { margin-top: 0.75rem; font-size: 0.875rem; color: #fca5a5; }
    </style>
  </head>
  <body>
    <form method="post">
      <h1>Admin</h1>
      <label for="password">Password</label>
      <input id="password" type="password" name="password" required autofocus />
      <input type="hidden" name="next" value={nextPath} />
      <button type="submit">Sign in</button>
      {error && <p class="error">{error}</p>}
    </form>
  </body>
</html>
