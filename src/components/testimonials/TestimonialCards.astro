---
interface Props {
  title?: string;
  testimonials: { quote: string; author: string; role?: string; image?: string }[];
}

const { title, testimonials } = Astro.props;
---

<section class="py-24 md:py-32 bg-[var(--color-muted,#f7f7f7)]" data-component="testimonial-cards">
  <div class="container-site">
    {title && (
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-12 text-center">{title}</h2>
    )}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-[var(--color-surface,#fff)] p-8 md:p-10">
          <p class="text-lg leading-relaxed text-[var(--color-fg,#111)]">"{t.quote}"</p>
          <div class="mt-6 flex items-center gap-3">
            {t.image && (
              <img
                src={t.image}
                alt={t.author}
                class="w-10 h-10 rounded-full object-cover"
                loading="lazy"
              />
            )}
            <div>
              <p class="font-semibold text-sm">{t.author}</p>
              {t.role && <p class="text-xs text-[var(--color-muted-fg,#888)]">{t.role}</p>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
