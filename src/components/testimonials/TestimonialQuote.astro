---
interface Props {
  quote: string;
  author: string;
  role?: string;
  image?: string;
}

const { quote, author, role, image } = Astro.props;
---

<section class="py-24 md:py-32" data-component="testimonial-quote">
  <div class="container-site max-w-3xl text-center">
    <blockquote>
      <p class="text-2xl sm:text-3xl md:text-4xl font-light leading-relaxed italic tracking-tight">
        "{quote}"
      </p>
    </blockquote>
    <div class="mt-10 flex items-center justify-center gap-4">
      {image && <img src={image} alt={author} class="w-14 h-14 rounded-full object-cover" loading="lazy" />}
      <div class:list={[image ? 'text-left' : 'text-center']}>
        <p class="font-semibold">{author}</p>
        {role && <p class="text-sm text-[var(--color-muted-fg,#888)] mt-0.5">{role}</p>}
      </div>
    </div>
  </div>
</section>
