---
interface Props { testimonials: { quote: string; author: string }[] }
const { testimonials } = Astro.props;
---
<section class="py-24 md:py-32 bg-[var(--color-muted,#f7f7f7)]" data-component="testimonial-minimal">
  <div class="container-site">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {testimonials.map((t) => (
        <div class="border-l-2 border-[var(--color-border,#ddd)] pl-6">
          <p class="text-lg leading-relaxed italic">"{t.quote}"</p>
          <p class="mt-4 text-sm font-semibold">{t.author}</p>
        </div>
      ))}
    </div>
  </div>
</section>
