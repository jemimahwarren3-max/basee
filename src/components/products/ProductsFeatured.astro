---
interface Props { tag?: string; title: string; description: string; image: string; price?: string; cta?: { label: string; href: string } }
const { tag, title, description, image, price, cta } = Astro.props;
---
<section class="py-24 md:py-32" data-component="products-featured">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="bg-[var(--color-muted,#f5f5f5)] p-8 md:p-16"><img src={image} alt={title} class="w-full aspect-square object-contain" loading="lazy" /></div>
      <div>
        {tag && <span class="text-xs uppercase tracking-widest text-[var(--color-muted-fg,#999)] mb-4 block">{tag}</span>}
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
        {price && <p class="mt-2 text-2xl font-light text-[var(--color-muted-fg,#666)]">{price}</p>}
        <p class="mt-6 text-lg text-[var(--color-muted-fg,#666)] leading-relaxed">{description}</p>
        {cta && <a href={cta.href} class="mt-8 inline-block px-8 py-3.5 bg-[var(--color-primary,#111)] text-[var(--color-bg,#fff)] text-sm font-medium hover:opacity-90 transition-opacity">{cta.label}</a>}
      </div>
    </div>
  </div>
</section>
