---
interface Props {
  title?: string;
  products: { name: string; image: string; price: string; href: string; tag?: string }[];
}
const { title = 'New Arrivals', products } = Astro.props;
---

<section class="py-24 md:py-32" data-component="products-new-arrivals">
  <div class="container-site">
    <div class="flex items-center justify-between mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h2>
      <a href="#" class="text-sm font-medium text-[var(--color-accent,#6366F1)]">
        View All
      </a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group">
          <div class="relative aspect-[3/4] overflow-hidden rounded-lg bg-[var(--color-surface,#f5f5f5)]">
            <img
              src={p.image}
              alt={p.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {p.tag && (
              <span class="absolute top-3 left-3 text-xs font-medium bg-[var(--color-fg,#111)] text-white px-2 py-1 rounded">
                {p.tag}
              </span>
            )}
          </div>
          <h3 class="mt-3 text-sm font-medium">{p.name}</h3>
          <p class="text-sm text-[var(--color-muted-fg,#666)]">{p.price}</p>
        </a>
      ))}
    </div>
  </div>
</section>
