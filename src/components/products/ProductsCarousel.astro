---
interface Props { title: string; products: { name: string; price?: string; image: string; href?: string }[] }
const { title, products } = Astro.props;
---
<section class="py-24 md:py-32" data-component="products-carousel">
  <div class="container-site mb-8"><h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2></div>
  <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory px-[var(--spacing-gutter)] pb-4" style="scrollbar-width:none;">
    {products.map((p) => (
      <a href={p.href || '#'} class="flex-none w-[70vw] sm:w-[45vw] lg:w-[28vw] snap-start group">
        <div class="overflow-hidden bg-[var(--color-muted,#f5f5f5)]">
          <img src={p.image} alt={p.name} class="w-full aspect-[3/4] object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
        </div>
        <div class="mt-4 flex justify-between">
          <h3 class="font-medium">{p.name}</h3>
          {p.price && <span class="text-[var(--color-muted-fg,#888)]">{p.price}</span>}
        </div>
      </a>
    ))}
  </div>
</section>
