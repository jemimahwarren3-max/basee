---
interface Props { products: { name: string; price: string; image: string; href?: string }[] }
const { products } = Astro.props;
---
<section class="py-24 md:py-32" data-component="products-minimal">
  <div class="container-site">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {products.map((p) => (
        <a href={p.href || '#'} class="group">
          <img src={p.image} alt={p.name} class="w-full aspect-square object-cover bg-[var(--color-muted,#f5f5f5)]" loading="lazy" />
          <p class="mt-3 text-sm font-medium">{p.name}</p>
          <p class="text-sm text-[var(--color-muted-fg,#888)]">{p.price}</p>
        </a>
      ))}
    </div>
  </div>
</section>
