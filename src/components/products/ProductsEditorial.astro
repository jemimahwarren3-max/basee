---
interface Props {
  title: string;
  products: { name: string; description: string; price?: string; image: string; href?: string }[];
}

const { title, products } = Astro.props;
---

<section class="py-24 md:py-32" data-component="products-editorial">
  <div class="container-site">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-tight mb-20">{title}</h2>
    <div class="space-y-24 md:space-y-32">
      {products.map((p, i) => (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class:list={[i % 2 === 1 ? 'lg:order-2' : '']}>
            <img src={p.image} alt={p.name} class="w-full aspect-[4/5] object-cover" loading="lazy" />
          </div>
          <div class:list={[i % 2 === 1 ? 'lg:order-1 lg:pr-16' : 'lg:pl-16']}>
            <h3 class="text-2xl md:text-3xl font-semibold">{p.name}</h3>
            {p.price && <p class="mt-2 text-lg text-[var(--color-muted-fg,#888)]">{p.price}</p>}
            <p class="mt-4 text-[var(--color-muted-fg,#666)] leading-relaxed text-lg">{p.description}</p>
            {p.href && (
              <a href={p.href} class="mt-6 inline-block text-sm uppercase tracking-widest border-b border-current pb-1 hover:opacity-70 transition-opacity">
                View details
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
