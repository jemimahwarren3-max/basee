---
interface Props { title: string; subtitle?: string; image: string; price?: string; badge?: string; cta: { label: string; href: string } }
const { title, subtitle, image, price, badge, cta } = Astro.props;
---
<section class="py-24 md:py-32" data-component="products-banner">
  <div class="container-site">
    <div class="relative overflow-hidden rounded-2xl bg-[var(--color-fg,#111)]">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="p-8 md:p-16 flex flex-col justify-center">
          {badge && <span class="inline-block self-start text-xs font-medium uppercase tracking-widest bg-[var(--color-accent,#6366F1)] text-white px-3 py-1 rounded-full mb-4">{badge}</span>}
          <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">{title}</h2>
          {subtitle && <p class="mt-4 text-white/60">{subtitle}</p>}
          {price && <p class="mt-4 text-2xl font-bold text-white">{price}</p>}
          <a href={cta.href} class="mt-8 inline-flex self-start px-8 py-3 bg-white text-[var(--color-fg,#111)] font-medium rounded-md">{cta.label}</a>
        </div>
        <img src={image} alt={title} class="w-full h-64 md:h-full object-cover" loading="lazy" />
      </div>
    </div>
  </div>
</section>
