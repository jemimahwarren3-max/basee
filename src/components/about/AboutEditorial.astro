---
interface Props {
  tag?: string;
  title: string;
  paragraphs: string[];
  image: string;
  imagePosition?: 'left' | 'right';
}

const { tag, title, paragraphs, image, imagePosition = 'right' } = Astro.props;
---

<section class="py-24 md:py-32" data-component="about-editorial">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <div class:list={[imagePosition === 'left' ? 'lg:order-2' : 'lg:order-1']}>
        {tag && (
          <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-muted-fg,#888)] mb-4 block">
            {tag}
          </span>
        )}
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-light leading-[1.15] tracking-tight">
          {title}
        </h2>
        <div class="mt-8 space-y-6">
          {paragraphs.map((p) => (
            <p class="text-[var(--color-muted-fg,#555)] leading-relaxed text-lg">{p}</p>
          ))}
        </div>
      </div>
      <div class:list={[imagePosition === 'left' ? 'lg:order-1' : 'lg:order-2']}>
        <img src={image} alt="" class="w-full aspect-[4/5] object-cover" loading="lazy" />
      </div>
    </div>
  </div>
</section>
