---
interface Props {
  title: string;
  text: string;
  cta?: { label: string; href: string };
}

const { title, text, cta } = Astro.props;
---

<section class="py-24 md:py-32" data-component="about-minimal">
  <div class="container-site max-w-3xl">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-light leading-[1.2] tracking-tight">
      {title}
    </h2>
    <p class="mt-8 text-lg md:text-xl text-[var(--color-muted-fg,#555)] leading-[1.8]">{text}</p>
    {cta && (
      <a
        href={cta.href}
        class="mt-8 inline-block text-sm border-b border-current pb-1 hover:opacity-70 transition-opacity"
      >
        {cta.label}
      </a>
    )}
  </div>
</section>
