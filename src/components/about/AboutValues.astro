---
interface Props {
  title?: string;
  subtitle?: string;
  values: { icon?: string; title: string; description: string }[];
}
const { title = 'Our Values', subtitle, values } = Astro.props;
---

<section class="py-24 md:py-32 bg-[var(--color-surface,#f9f9f9)]" data-component="about-values">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {values.map((v) => (
        <div class="text-center p-8">
          {v.icon && <div class="text-4xl mb-4">{v.icon}</div>}
          <h3 class="text-xl font-semibold">{v.title}</h3>
          <p class="mt-3 text-[var(--color-muted-fg,#666)]">{v.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
