---
interface Props {
  title: string;
  subtitle?: string;
  columns: { title: string; text: string }[];
}

const { title, subtitle, columns } = Astro.props;
---

<section class="py-24 md:py-32" data-component="about-columns">
  <div class="container-site">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl font-semibold leading-tight tracking-tight">{title}</h2>
      {subtitle && (
        <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)] leading-relaxed">{subtitle}</p>
      )}
    </div>
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
      {columns.map((col) => (
        <div>
          <h3 class="text-lg font-semibold">{col.title}</h3>
          <p class="mt-3 text-[var(--color-muted-fg,#666)] leading-relaxed">{col.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
