---
interface Props {
  tag?: string;
  title: string;
  lead: string;
  values: { title: string; text: string }[];
  image?: string;
}

const { tag, title, lead, values, image } = Astro.props;
---

<section class="py-24 md:py-32" data-component="about-brand">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">
      <div class="lg:col-span-2">
        {tag && <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-muted-fg,#999)] mb-4 block">{tag}</span>}
        <h2 class="text-3xl sm:text-4xl font-light tracking-tight">{title}</h2>
        <p class="mt-6 text-lg text-[var(--color-muted-fg,#666)] leading-relaxed">{lead}</p>
        {image && <img src={image} alt="" class="mt-10 w-full aspect-[4/3] object-cover" loading="lazy" />}
      </div>
      <div class="lg:col-span-3 lg:pl-8">
        <div class="space-y-10">
          {values.map((v) => (
            <div class="border-l-2 border-[var(--color-border,#e5e5e5)] pl-6">
              <h3 class="text-lg font-semibold">{v.title}</h3>
              <p class="mt-2 text-[var(--color-muted-fg,#666)] leading-relaxed">{v.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
