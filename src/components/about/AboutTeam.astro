---
interface Props {
  title: string;
  subtitle?: string;
  members: { name: string; role: string; image: string; bio?: string }[];
}

const { title, subtitle, members } = Astro.props;
---

<section class="py-24 md:py-32" data-component="about-team">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    </div>
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-10">
      {members.map((m) => (
        <div class="text-center">
          <img
            src={m.image}
            alt={m.name}
            class="w-full aspect-[3/4] object-cover mb-5"
            loading="lazy"
          />
          <h3 class="font-semibold text-lg">{m.name}</h3>
          <p class="text-sm text-[var(--color-muted-fg,#888)] mt-1">{m.role}</p>
          {m.bio && (
            <p class="text-sm text-[var(--color-muted-fg,#666)] mt-3 leading-relaxed">{m.bio}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
