---
interface Props {
  brand: string;
  links: { label: string; href: string }[];
  cta?: { label: string; href: string };
  transparent?: boolean;
}

const { brand, links, cta, transparent = false } = Astro.props;
---

<nav
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-colors duration-300',
    transparent ? 'bg-transparent text-white' : 'bg-[var(--color-bg,#fff)] text-[var(--color-fg,#111)] border-b border-[var(--color-border,#e5e5e5)]',
  ]}
  data-nav="minimal"
>
  <div class="container-site flex items-center justify-between h-20">
    <a href="/" class="text-lg font-semibold tracking-tight">{brand}</a>

    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a href={link.href} class="text-sm hover:opacity-70 transition-opacity">{link.label}</a>
      ))}
      {cta && (
        <a href={cta.href} class="text-sm px-5 py-2.5 border border-current hover:bg-current hover:text-[var(--color-dark-fg,#fff)] transition-colors">
          {cta.label}
        </a>
      )}
    </div>

    <button
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span class="block w-6 h-px bg-current"></span>
      <span class="block w-6 h-px bg-current"></span>
    </button>
  </div>
</nav>

<!-- Mobile overlay -->
<div
  class="fixed inset-0 z-[60] bg-[var(--color-bg,#fff)] text-[var(--color-fg,#111)] flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300"
  data-menu-overlay
>
  <button class="absolute top-6 right-6 p-2" aria-label="Close menu" data-menu-close>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
  </button>
  {links.map((link) => (
    <a href={link.href} class="text-2xl hover:opacity-70 transition-opacity">{link.label}</a>
  ))}
  {cta && (
    <a href={cta.href} class="text-lg px-8 py-3 border border-current mt-4">{cta.label}</a>
  )}
</div>

<script>
  document.querySelectorAll('[data-menu-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const overlay = document.querySelector('[data-menu-overlay]');
      if (overlay) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100');
      }
    });
  });
  document.querySelectorAll('[data-menu-close]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const overlay = document.querySelector('[data-menu-overlay]');
      if (overlay) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100');
      }
    });
  });
</script>
