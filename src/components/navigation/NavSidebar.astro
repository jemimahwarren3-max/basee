---
interface Props {
  brand: string;
  links: { label: string; href: string }[];
  cta?: { label: string; href: string };
}
const { brand, links, cta } = Astro.props;
---

<nav
  class="fixed inset-y-0 left-0 w-64 bg-[var(--color-bg,#fff)] border-r border-[var(--color-border,#e5e5e5)] z-50 flex flex-col p-8 max-md:hidden"
  data-component="nav-sidebar"
>
  <a href="/" class="text-lg font-bold tracking-tight mb-12">
    {brand}
  </a>
  <ul class="flex flex-col gap-1 flex-1">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          class="block py-2 px-3 rounded-md text-sm text-[var(--color-muted-fg,#666)] hover:text-[var(--color-fg,#111)] hover:bg-[var(--color-surface,#f5f5f5)] transition-colors"
        >
          {l.label}
        </a>
      </li>
    ))}
  </ul>
  {cta && (
    <a
      href={cta.href}
      class="mt-auto block text-center py-3 px-4 bg-[var(--color-fg,#111)] text-[var(--color-dark-fg,#fff)] text-sm font-medium rounded-md"
    >
      {cta.label}
    </a>
  )}
</nav>
