---
interface Props {
  columns: string[];
  rows: (string | number)[][];
  caption?: string;
  empty?: string;
}
const { columns, rows, caption, empty = 'No records yet.' } = Astro.props;
---

<div class="bg-[var(--color-surface,#fff)] border border-[var(--color-border,#e5e5e5)] rounded-lg overflow-hidden">
  {caption && (
    <div class="px-5 py-3 text-sm font-medium border-b border-[var(--color-border,#e5e5e5)]">
      {caption}
    </div>
  )}
  {rows.length === 0 ? (
    <p class="px-5 py-10 text-center text-sm text-[var(--color-muted-fg,#999)]">{empty}</p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-[var(--color-muted,#f7f7f7)] text-xs uppercase tracking-widest text-[var(--color-muted-fg,#666)]">
          <tr>
            {columns.map((c) => (
              <th class="text-left px-5 py-3 font-medium">{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-[var(--color-border,#e5e5e5)]">
              {row.map((cell) => (
                <td class="px-5 py-3 tabular-nums">{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>
