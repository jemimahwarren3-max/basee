---
interface Props {
  title: string;
  points: { label: string; value: number }[];
  unit?: string;
  height?: number;
}
const { title, points, unit = '', height = 160 } = Astro.props;
const values = points.map((p) => p.value);
const max = Math.max(1, ...values);
const min = Math.min(0, ...values);
const range = max - min || 1;
const width = 400;
const pad = 20;
const step = points.length > 1 ? (width - pad * 2) / (points.length - 1) : 0;
const coords = points.map((p, i) => {
  const x = pad + i * step;
  const y = pad + (1 - (p.value - min) / range) * (height - pad * 2);
  return { x, y, ...p };
});
const line = coords
  .map((c, i) => `${i === 0 ? 'M' : 'L'}${c.x.toFixed(1)} ${c.y.toFixed(1)}`)
  .join(' ');
const area = `${line} L${coords[coords.length - 1]?.x.toFixed(1)} ${height - pad} L${coords[0]?.x.toFixed(1)} ${height - pad} Z`;
---

<div class="bg-[var(--color-surface,#fff)] border border-[var(--color-border,#e5e5e5)] rounded-lg p-5">
  <p class="text-sm font-medium">{title}</p>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="mt-4 w-full h-40"
    preserveAspectRatio="none"
    role="img"
    aria-label={title}
  >
    <path d={area} fill="var(--color-primary, #111)" fill-opacity="0.08" />
    <path
      d={line}
      fill="none"
      stroke="var(--color-primary, #111)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    {coords.map((c) => (
      <circle cx={c.x} cy={c.y} r="3" fill="var(--color-primary, #111)">
        <title>{`${c.label}: ${c.value}${unit}`}</title>
      </circle>
    ))}
  </svg>
  <div class="mt-2 flex justify-between text-[10px] text-[var(--color-muted-fg,#999)]">
    {points.map((p) => (
      <span>{p.label}</span>
    ))}
  </div>
</div>
