---
interface Props {
  status: 'ok' | 'warn' | 'error' | 'info' | 'neutral';
  label: string;
}
const { status, label } = Astro.props;
const styles: Record<Props['status'], string> = {
  ok: 'bg-green-100 text-green-800',
  warn: 'bg-yellow-100 text-yellow-800',
  error: 'bg-red-100 text-red-800',
  info: 'bg-blue-100 text-blue-800',
  neutral: 'bg-[var(--color-muted,#f5f5f5)] text-[var(--color-muted-fg,#666)]',
};
const dot: Record<Props['status'], string> = {
  ok: 'bg-green-500',
  warn: 'bg-yellow-500',
  error: 'bg-red-500',
  info: 'bg-blue-500',
  neutral: 'bg-[var(--color-muted-fg,#999)]',
};
---
<span class={`inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium ${styles[status]}`}>
  <span class={`w-1.5 h-1.5 rounded-full ${dot[status]}`}></span>
  {label}
</span>
