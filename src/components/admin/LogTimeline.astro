---
interface Props {
  title?: string;
  events: { time: string; title: string; detail?: string; status?: 'ok' | 'warn' | 'error' | 'info' }[];
  empty?: string;
}
const { title, events, empty = 'No activity.' } = Astro.props;
const dot: Record<NonNullable<Props['events'][number]['status']>, string> = {
  ok: 'bg-green-500',
  warn: 'bg-yellow-500',
  error: 'bg-red-500',
  info: 'bg-blue-500',
};
---
<div class="bg-[var(--color-surface,#fff)] border border-[var(--color-border,#e5e5e5)] rounded-lg p-5">
  {title && <p class="text-sm font-medium mb-4">{title}</p>}
  {events.length === 0 ? (
    <p class="py-6 text-sm text-center text-[var(--color-muted-fg,#999)]">{empty}</p>
  ) : (
    <ol class="relative ml-2">
      <div class="absolute left-[3px] top-1 bottom-1 w-px bg-[var(--color-border,#e5e5e5)]" aria-hidden="true"></div>
      {events.map((e) => (
        <li class="relative pl-6 pb-5 last:pb-0">
          <span class={`absolute left-0 top-1.5 w-2 h-2 rounded-full ring-2 ring-[var(--color-surface,#fff)] ${e.status ? dot[e.status] : 'bg-[var(--color-muted-fg,#999)]'}`}></span>
          <div class="flex items-baseline gap-3">
            <time class="text-xs text-[var(--color-muted-fg,#999)] tabular-nums">{e.time}</time>
            <p class="text-sm font-medium">{e.title}</p>
          </div>
          {e.detail && <p class="mt-1 text-sm text-[var(--color-muted-fg,#666)]">{e.detail}</p>}
        </li>
      ))}
    </ol>
  )}
</div>
