---
// Client-side password gate for the admin.
//
// IMPORTANT: this is a deterrent, not real security.
// The admin HTML is still served to anyone who requests it. The gate hides it
// visually and blocks casual visitors. For actual protection, use one of:
//   - Netlify: Site settings → Build & deploy → Password protection
//   - Cloudflare Pages + Access: Zero Trust access policy on /admin/*
//   - Switch Astro to server mode and enforce auth in middleware (see docs)
//
// The gate expects ADMIN_PASSWORD_HASH (SHA-256 hex) in your env at build time.
// Generate one with: npm run hash-password -- 'yourpassword'
const hash = import.meta.env.ADMIN_PASSWORD_HASH ?? '';
---

<div
  id="admin-gate"
  data-hash={hash}
  class="hidden fixed inset-0 z-[9999] bg-[var(--color-fg,#111)] text-white items-center justify-center p-6"
>
  <form id="admin-gate-form" class="max-w-sm w-full">
    <div class="text-xs uppercase tracking-widest text-white/50 mb-2">Admin</div>
    <h1 class="text-2xl font-semibold">Password required</h1>
    <p class="mt-2 text-sm text-white/60">
      {hash
        ? 'Enter the admin password to continue.'
        : 'No ADMIN_PASSWORD_HASH set. See CLAUDE.md to configure.'}
    </p>
    <input
      type="password"
      name="password"
      autocomplete="current-password"
      placeholder="Password"
      required
      class="mt-6 w-full px-4 py-3 bg-white/10 border border-white/20 text-white placeholder:text-white/40 rounded focus:outline-none focus:border-white/60"
    />
    <button
      type="submit"
      class="mt-4 w-full px-4 py-3 bg-white text-[var(--color-fg,#111)] font-medium rounded"
    >
      Unlock
    </button>
    <p id="admin-gate-error" class="mt-3 text-sm text-red-300 hidden">
      Wrong password.
    </p>
  </form>
</div>

<script>
  const gate = document.getElementById('admin-gate') as HTMLElement | null;
  if (gate) {
    const hash = gate.dataset.hash || '';
    const key = 'admin-authed';

    const show = () => {
      gate.classList.remove('hidden');
      gate.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const hide = () => {
      gate.classList.add('hidden');
      gate.classList.remove('flex');
      document.body.style.overflow = '';
    };

    async function sha256Hex(text: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    let authed = false;
    try {
      authed = sessionStorage.getItem(key) === hash && !!hash;
    } catch {}

    if (!authed) show();

    const form = document.getElementById('admin-gate-form') as HTMLFormElement | null;
    const error = document.getElementById('admin-gate-error') as HTMLElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!hash) return;
      const input = form.querySelector<HTMLInputElement>('input[name="password"]');
      const value = input?.value ?? '';
      const typed = await sha256Hex(value);
      if (typed === hash) {
        try {
          sessionStorage.setItem(key, hash);
        } catch {}
        hide();
      } else {
        error?.classList.remove('hidden');
      }
    });
  }
</script>
