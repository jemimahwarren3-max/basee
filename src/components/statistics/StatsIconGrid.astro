---
interface Props { title?: string; stats: { value: string; label: string; icon?: string }[] }
const { title, stats } = Astro.props;
---
<section class="py-24 md:py-32 bg-[var(--color-surface,#f9f9f9)]" data-component="stats-icon-grid">
  <div class="container-site">
    {title && <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-16">{title}</h2>}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map(s => (
        <div class="text-center">
          {s.icon && <div class="text-3xl mb-3">{s.icon}</div>}
          <p class="text-3xl md:text-4xl font-bold">{s.value}</p>
          <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)]">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
