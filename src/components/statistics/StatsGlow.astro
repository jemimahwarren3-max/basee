---
interface Props { stats: { value: string; label: string }[] }
const { stats } = Astro.props;
---
<section class="py-20 md:py-28 bg-[#09090B] text-white" data-component="stats-glow">
  <div class="container-site">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map((s) => (
        <div class="p-6 rounded-xl bg-white/5 border border-white/10">
          <span class="text-4xl md:text-5xl font-light bg-gradient-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent">{s.value}</span>
          <p class="mt-2 text-sm text-white/50">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
