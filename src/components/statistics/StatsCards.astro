---
interface Props { stats: { value: string; label: string; description?: string }[] }
const { stats } = Astro.props;
---
<section class="py-24 md:py-32" data-component="stats-cards">
  <div class="container-site">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {stats.map(s => (
        <div class="bg-[var(--color-surface,#f9f9f9)] rounded-xl p-8 text-center">
          <p class="text-4xl font-bold">{s.value}</p>
          <p class="mt-2 text-sm font-medium uppercase tracking-wider">{s.label}</p>
          {s.description && <p class="mt-2 text-xs text-[var(--color-muted-fg,#999)]">{s.description}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
