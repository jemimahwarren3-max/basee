---
interface Props {
  title?: string;
  stats: { label: string; value: number; max?: number; display: string }[];
}
const { title, stats } = Astro.props;
---

<section class="py-24 md:py-32" data-component="stats-progress">
  <div class="container-site max-w-3xl">
    {title && (
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-16">{title}</h2>
    )}
    <div class="space-y-8">
      {stats.map((s) => (
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-medium">{s.label}</span>
            <span class="text-sm font-bold">{s.display}</span>
          </div>
          <div class="h-2 bg-[var(--color-border,#e5e5e5)] rounded-full overflow-hidden">
            <div
              class="h-full bg-[var(--color-accent,#6366F1)] rounded-full"
              style={`width: ${(s.value / (s.max || 100)) * 100}%`}
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
