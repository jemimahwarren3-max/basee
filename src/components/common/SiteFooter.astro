---
// Family-aware footer wrapper. Reads from src/site.config and renders a
// footer variant. Override with the `variant` prop.
import { site, copyright } from '../../site.config';
import FooterSimple from '../footers/FooterSimple.astro';
import FooterMinimal from '../footers/FooterMinimal.astro';
import FooterColumns from '../footers/FooterColumns.astro';
import FooterFull from '../footers/FooterFull.astro';
import FooterDark from '../footers/FooterDark.astro';

interface Props {
  variant?: 'simple' | 'minimal' | 'columns' | 'full' | 'dark';
}
const { variant = 'columns' } = Astro.props;

const brand = site.name || 'Site';
const copy = copyright();

// Build generic columns from the config for the richer variants.
const contactLinks: { label: string; href: string }[] = [];
if (site.contact.address) contactLinks.push({ label: site.contact.address, href: '#' });
if (site.contact.email) contactLinks.push({ label: site.contact.email, href: `mailto:${site.contact.email}` });
if (site.contact.phone) contactLinks.push({ label: site.contact.phone, href: `tel:${site.contact.phone}` });
if (site.contact.hours) contactLinks.push({ label: site.contact.hours, href: '#' });

const columns = [
  site.nav.length > 0 ? { title: 'Site', links: site.nav } : null,
  contactLinks.length > 0 ? { title: 'Contact', links: contactLinks } : null,
].filter(Boolean) as { title: string; links: { label: string; href: string }[] }[];

// FooterFull needs {platform, url}; the others need {label, href}.
const socialsFull = site.social;
const socialsFlat = site.social.map((s) => ({ label: s.platform, href: s.url }));
---
{variant === 'simple' && <FooterSimple brand={brand} links={site.nav} copyright={copy} />}
{variant === 'minimal' && <FooterMinimal brand={brand} links={site.nav} socials={socialsFlat} copyright={copy} />}
{variant === 'columns' && <FooterColumns brand={brand} description={site.description} columns={columns} socials={socialsFlat} copyright={copy} />}
{variant === 'full' && <FooterFull brand={brand} description={site.description} columns={columns} socials={socialsFull} copyright={copy} />}
{variant === 'dark' && <FooterDark brand={brand} description={site.description} links={site.nav} email={site.contact.email || undefined} phone={site.contact.phone || undefined} socials={socialsFlat} />}
