---
interface Props {
  title: string;
  subtitle?: string;
  cta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { title, subtitle, cta, secondaryCta } = Astro.props;
---

<section class="py-24 md:py-32 text-center" data-component="cta-simple">
  <div class="container-site max-w-2xl">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">{title}</h2>
    {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={cta.href} class="px-8 py-3.5 bg-[var(--color-primary,#111)] text-[var(--color-dark-fg,#fff)] text-sm font-medium hover:opacity-90 transition-opacity">
        {cta.label}
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class="text-sm font-medium hover:opacity-70 transition-opacity">{secondaryCta.label} →</a>
      )}
    </div>
  </div>
</section>
