---
interface Props {
  title: string;
  subtitle?: string;
  cta: { label: string; href: string };
}

const { title, subtitle, cta } = Astro.props;
---

<section
  class="py-24 md:py-32 bg-[var(--color-dark-bg,#0a0a0a)] text-[var(--color-dark-fg,#fff)]"
  data-component="cta-dark"
>
  <div class="container-site text-center max-w-3xl">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">{title}</h2>
    {subtitle && <p class="mt-4 text-lg text-white/60 max-w-lg mx-auto">{subtitle}</p>}
    <a
      href={cta.href}
      class="mt-8 inline-block px-8 py-3.5 bg-white text-black text-sm font-medium hover:bg-white/90 transition-colors"
    >
      {cta.label}
    </a>
  </div>
</section>
