---
interface Props { title: string; subtitle?: string; image: string; cta: { label: string; href: string }; secondaryCta?: { label: string; href: string } }
const { title, subtitle, image, cta, secondaryCta } = Astro.props;
---
<section class="relative min-h-[60vh] flex items-center justify-center" data-component="cta-fullscreen">
  <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
  <div class="absolute inset-0 bg-black/60" />
  <div class="relative text-center container-site py-24">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight">{title}</h2>
    {subtitle && <p class="mt-4 text-lg text-white/70 max-w-2xl mx-auto">{subtitle}</p>}
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href={cta.href} class="px-8 py-3 bg-white text-black font-medium rounded-md">{cta.label}</a>
      {secondaryCta && <a href={secondaryCta.href} class="px-8 py-3 border border-white/30 text-white font-medium rounded-md">{secondaryCta.label}</a>}
    </div>
  </div>
</section>
