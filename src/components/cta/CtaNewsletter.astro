---
interface Props { title: string; subtitle?: string; placeholder?: string; buttonText?: string }
const { title, subtitle, placeholder = 'Enter your email', buttonText = 'Subscribe' } = Astro.props;
---
<section class="py-24 md:py-32 bg-[var(--color-surface,#f9f9f9)]" data-component="cta-newsletter">
  <div class="container-site max-w-2xl text-center">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h2>
    {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    <form class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md mx-auto" data-newsletter>
      <input type="email" required placeholder={placeholder} class="flex-1 px-4 py-3 border border-[var(--color-border,#e5e5e5)] rounded-md bg-[var(--color-bg,#fff)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent,#6366F1)]" />
      <button type="submit" class="px-6 py-3 bg-[var(--color-fg,#111)] text-[var(--color-bg,#fff)] text-sm font-medium rounded-md whitespace-nowrap">{buttonText}</button>
    </form>
    <p class="mt-3 text-xs text-[var(--color-muted-fg,#999)]">No spam. Unsubscribe anytime.</p>
  </div>
</section>
