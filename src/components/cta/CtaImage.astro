---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  cta: { label: string; href: string };
}

const { title, subtitle, image, cta } = Astro.props;
---

<section class="relative py-24 md:py-32 overflow-hidden" data-component="cta-image">
  <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
  <div class="absolute inset-0 bg-black/50" />
  <div class="container-site relative z-10 text-center text-white">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-tight">{title}</h2>
    {subtitle && <p class="mt-4 text-lg text-white/70 max-w-lg mx-auto">{subtitle}</p>}
    <a href={cta.href} class="mt-8 inline-block text-sm uppercase tracking-[0.15em] border border-white/60 px-8 py-4 hover:bg-white hover:text-black transition-all duration-500">
      {cta.label}
    </a>
  </div>
</section>
