---
interface Props { title: string; text: string; cta: { label: string; href: string }; image: string }
const { title, text, cta, image } = Astro.props;
---
<section class="py-24 md:py-32" data-component="cta-split">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
        <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)] leading-relaxed">{text}</p>
        <a href={cta.href} class="mt-8 inline-block px-8 py-3.5 bg-[var(--color-primary,#111)] text-[var(--color-bg,#fff)] text-sm font-medium hover:opacity-90 transition-opacity">{cta.label}</a>
      </div>
      <img src={image} alt="" class="w-full aspect-[4/3] object-cover" loading="lazy" />
    </div>
  </div>
</section>
