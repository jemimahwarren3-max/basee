---
interface Props { title?: string; subtitle?: string; offices: { city: string; address: string; phone?: string; email?: string }[]; socials?: { platform: string; url: string }[] }
const { title = 'Get In Touch', subtitle, offices, socials } = Astro.props;
---
<section class="py-24 md:py-32" data-component="contact-detailed">
  <div class="container-site">
    <div class="max-w-2xl mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {offices.map(o => (
        <div class="border border-[var(--color-border,#e5e5e5)] rounded-xl p-8">
          <h3 class="text-lg font-semibold">{o.city}</h3>
          <p class="mt-3 text-sm text-[var(--color-muted-fg,#666)]">{o.address}</p>
          {o.phone && <a href={`tel:${o.phone}`} class="mt-3 block text-sm text-[var(--color-muted-fg,#666)] hover:text-[var(--color-fg,#111)]">{o.phone}</a>}
          {o.email && <a href={`mailto:${o.email}`} class="mt-1 block text-sm text-[var(--color-accent,#6366F1)]">{o.email}</a>}
        </div>
      ))}
    </div>
    {socials && (
      <div class="mt-12 flex gap-6">
        {socials.map(s => <a href={s.url} class="text-sm text-[var(--color-muted-fg,#999)] hover:text-[var(--color-fg,#111)] transition-colors" target="_blank" rel="noopener">{s.platform}</a>)}
      </div>
    )}
  </div>
</section>
