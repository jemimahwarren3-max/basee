---
import FormSpamGuard from '../interactive/FormSpamGuard.astro';

interface Props {
  title: string;
  subtitle?: string;
  fields?: ('name' | 'email' | 'phone' | 'company' | 'message' | 'subject')[];
  submitLabel?: string;
  action?: string;
}

const {
  title,
  subtitle,
  fields = ['name', 'email', 'message'],
  submitLabel = 'Send message',
  action = '#',
} = Astro.props;

const fieldConfig: Record<
  string,
  { label: string; type: string; required: boolean; full?: boolean }
> = {
  name: { label: 'Full name', type: 'text', required: true },
  email: { label: 'Email address', type: 'email', required: true },
  phone: { label: 'Phone number', type: 'tel', required: false },
  company: { label: 'Company', type: 'text', required: false },
  subject: { label: 'Subject', type: 'text', required: false, full: true },
  message: { label: 'Message', type: 'textarea', required: true, full: true },
};
---

<section class="py-24 md:py-32" data-component="contact-form">
  <div class="container-site max-w-2xl">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
    {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}

    <form
      action={action}
      method="post"
      class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6"
      data-ajax-form
    >
      <div class="hidden md:col-span-2 text-center py-8" data-form-success>
        <p class="text-xl font-semibold">Thank you — your message is on its way.</p>
        <p class="mt-2 text-[var(--color-muted-fg,#666)]">We'll reply as soon as we can.</p>
      </div>
      <div class="hidden md:col-span-2 text-sm text-red-600" data-form-error></div>
      <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6" data-form-body>
        <FormSpamGuard />
        {fields.map((key) => {
          const f = fieldConfig[key];
          if (!f) return null;
          const isTextarea = f.type === 'textarea';
          return (
            <div class:list={[f.full || isTextarea ? 'md:col-span-2' : '']}>
              <label for={key} class="block text-sm font-medium mb-2">
                {f.label}
                {f.required && ' *'}
              </label>
              {isTextarea ? (
                <textarea
                  id={key}
                  name={key}
                  rows={5}
                  required={f.required}
                  class="w-full px-4 py-3 border border-[var(--color-border,#e5e5e5)] bg-transparent focus:border-[var(--color-fg,#111)] focus:outline-none transition-colors resize-none"
                />
              ) : (
                <input
                  type={f.type}
                  id={key}
                  name={key}
                  required={f.required}
                  class="w-full px-4 py-3 border border-[var(--color-border,#e5e5e5)] bg-transparent focus:border-[var(--color-fg,#111)] focus:outline-none transition-colors"
                />
              )}
            </div>
          );
        })}
        <div class="md:col-span-2">
          <button
            type="submit"
            class="px-8 py-3.5 bg-[var(--color-primary,#111)] text-[var(--color-dark-fg,#fff)] text-sm font-medium hover:opacity-90 transition-opacity"
          >
            {submitLabel}
          </button>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-ajax-form]').forEach((form) => {
    if (form.dataset.ajaxBound) return;
    form.dataset.ajaxBound = '1';
    if (form.action === window.location.href || form.action.endsWith('#')) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = form.querySelector<HTMLElement>('[data-form-body]');
      const success = form.querySelector<HTMLElement>('[data-form-success]');
      const error = form.querySelector<HTMLElement>('[data-form-error]');
      error?.classList.add('hidden');

      const data = new FormData(form);
      const honey = (data.get('website') ?? '').toString();
      const created = Number(data.get('_created') ?? 0);
      if (honey.trim() !== '' || (created && Date.now() - created < 2000)) {
        body?.classList.add('hidden');
        success?.classList.remove('hidden');
        return;
      }
      data.delete('website');
      data.delete('_created');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`Server returned ${res.status}`);
        body?.classList.add('hidden');
        success?.classList.remove('hidden');
      } catch (err) {
        if (error) {
          error.textContent =
            err instanceof Error ? err.message : 'Submission failed. Please try again.';
          error.classList.remove('hidden');
        }
      }
    });
  });
</script>
