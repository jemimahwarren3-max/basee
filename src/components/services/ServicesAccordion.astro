---
interface Props { title?: string; services: { title: string; description: string; image?: string }[] }
const { title = 'Our Services', services } = Astro.props;
---
<section class="py-24 md:py-32" data-component="services-accordion">
  <div class="container-site grid grid-cols-1 md:grid-cols-2 gap-16">
    <div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight sticky top-32">{title}</h2>
    </div>
    <div class="divide-y divide-[var(--color-border,#e5e5e5)]">
      {services.map(s => (
        <details class="group py-6">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="text-xl font-semibold">{s.title}</h3>
            <svg class="w-5 h-5 flex-none group-open:rotate-45 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 4v12M4 10h12"/></svg>
          </summary>
          <div class="pt-4">
            <p class="text-[var(--color-muted-fg,#666)] leading-relaxed">{s.description}</p>
            {s.image && <img src={s.image} alt="" class="w-full aspect-video object-cover rounded-lg mt-4" loading="lazy" />}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
