---
interface Props {
  title: string;
  services: { title: string; description: string; href?: string }[];
}
const { title, services } = Astro.props;
---

<section class="py-24 md:py-32 bg-[var(--color-muted,#f7f7f7)]" data-component="services-compact">
  <div class="container-site">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-12">{title}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-border,#e5e5e5)]">
      {services.map((s) => (
        <div class="bg-[var(--color-surface,#fff)] p-8">
          <h3 class="font-semibold text-lg">{s.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)] leading-relaxed">
            {s.description}
          </p>
          {s.href && (
            <a href={s.href} class="mt-3 inline-block text-sm hover:opacity-70 transition-opacity">
              →
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
