---
interface Props {
  tag?: string;
  title: string;
  services: { title: string; description: string; image: string; href?: string }[];
}

const { tag, title, services } = Astro.props;
---

<section class="py-24 md:py-32" data-component="services-alternating">
  <div class="container-site">
    {tag && (
      <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-muted-fg,#888)] mb-4 block">
        {tag}
      </span>
    )}
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-tight mb-20">{title}</h2>

    <div class="space-y-24 md:space-y-32">
      {services.map((s, i) => (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class:list={[i % 2 === 1 ? 'lg:order-2' : '']}>
            <h3 class="text-2xl md:text-3xl font-semibold leading-tight">{s.title}</h3>
            <p class="mt-4 text-[var(--color-muted-fg,#666)] leading-relaxed text-lg">
              {s.description}
            </p>
            {s.href && (
              <a
                href={s.href}
                class="mt-6 inline-block text-sm uppercase tracking-widest border-b border-current pb-1 hover:opacity-70 transition-opacity"
              >
                Discover
              </a>
            )}
          </div>
          <div class:list={[i % 2 === 1 ? 'lg:order-1' : '']}>
            <img src={s.image} alt="" class="w-full aspect-[4/3] object-cover" loading="lazy" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
