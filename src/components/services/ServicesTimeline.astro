---
interface Props {
  title: string;
  steps: { number: string; title: string; description: string }[];
}

const { title, steps } = Astro.props;
---

<section class="py-24 md:py-32" data-component="services-timeline">
  <div class="container-site max-w-3xl">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-16 text-center">{title}</h2>
    <div class="space-y-12">
      {steps.map((s) => (
        <div class="flex gap-6">
          <div class="flex-none w-12 h-12 rounded-full bg-[var(--color-muted,#f5f5f5)] flex items-center justify-center text-sm font-semibold">{s.number}</div>
          <div class="pt-2">
            <h3 class="text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-[var(--color-muted-fg,#666)] leading-relaxed">{s.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
