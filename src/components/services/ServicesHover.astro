---
interface Props { title: string; services: { title: string; description: string; image: string }[] }
const { title, services } = Astro.props;
---
<section class="py-24 md:py-32" data-component="services-hover">
  <div class="container-site">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-16">{title}</h2>
    <div class="divide-y divide-[var(--color-border,#e5e5e5)]">
      {services.map((s) => (
        <div class="group relative py-8 md:py-12 flex items-center justify-between cursor-pointer">
          <div>
            <h3 class="text-2xl md:text-3xl font-semibold group-hover:translate-x-4 transition-transform duration-300">{s.title}</h3>
            <p class="mt-1 text-[var(--color-muted-fg,#888)] text-sm max-w-md">{s.description}</p>
          </div>
          <img src={s.image} alt="" class="hidden lg:block absolute right-0 top-1/2 -translate-y-1/2 w-72 h-48 object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-10" loading="lazy" />
          <span class="text-sm text-[var(--color-muted-fg,#999)]">→</span>
        </div>
      ))}
    </div>
  </div>
</section>
