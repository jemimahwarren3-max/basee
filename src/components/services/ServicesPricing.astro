---
interface Props {
  title?: string;
  services: {
    title: string;
    description: string;
    price: string;
    unit?: string;
    features?: string[];
  }[];
}
const { title = 'Services & Pricing', services } = Astro.props;
---

<section class="py-24 md:py-32" data-component="services-pricing">
  <div class="container-site">
    {title && (
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-16">{title}</h2>
    )}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s) => (
        <div class="border border-[var(--color-border,#e5e5e5)] rounded-xl p-8">
          <h3 class="text-xl font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)]">{s.description}</p>
          <p class="mt-6">
            <span class="text-3xl font-bold">{s.price}</span>
            {s.unit && <span class="text-sm text-[var(--color-muted-fg,#999)]"> / {s.unit}</span>}
          </p>
          {s.features && (
            <ul class="mt-6 space-y-2 border-t border-[var(--color-border,#e5e5e5)] pt-6">
              {s.features.map((f) => (
                <li class="flex items-center gap-2 text-sm text-[var(--color-muted-fg,#666)]">
                  <span class="text-[var(--color-accent,#6366F1)]">✓</span> {f}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
