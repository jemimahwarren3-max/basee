---
interface Props { services: { title: string; description: string }[] }
const { services } = Astro.props;
---
<section class="py-24 md:py-32" data-component="services-minimal">
  <div class="container-site max-w-4xl">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      {services.map((s) => (
        <div>
          <h3 class="text-xl font-semibold mb-3">{s.title}</h3>
          <p class="text-[var(--color-muted-fg,#666)] leading-relaxed">{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
