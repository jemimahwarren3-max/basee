---
interface Props {
  title?: string;
  services: {
    title: string;
    description: string;
    image?: string;
    span?: 'wide' | 'tall' | 'normal';
  }[];
}
const { title = 'Services', services } = Astro.props;
---

<section class="py-24 md:py-32" data-component="services-bento">
  <div class="container-site">
    {title && (
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-16">{title}</h2>
    )}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {services.map((s) => (
        <div
          class:list={[
            'bg-[var(--color-surface,#f9f9f9)] rounded-2xl overflow-hidden',
            s.span === 'wide' ? 'md:col-span-2' : '',
            s.span === 'tall' ? 'md:row-span-2' : '',
          ]}
        >
          {s.image && (
            <img src={s.image} alt="" class="w-full aspect-video object-cover" loading="lazy" />
          )}
          <div class="p-6 md:p-8">
            <h3 class="text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)]">{s.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
