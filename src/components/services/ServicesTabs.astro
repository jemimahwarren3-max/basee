---
interface Props {
  title: string;
  tabs: { label: string; title: string; description: string; image?: string; features?: string[] }[];
}

const { title, tabs } = Astro.props;
---

<section class="py-24 md:py-32" data-component="services-tabs">
  <div class="container-site">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-12">{title}</h2>
    <div class="flex gap-4 overflow-x-auto border-b border-[var(--color-border,#e5e5e5)] mb-12 pb-0">
      {tabs.map((tab, i) => (
        <button
          class:list={['text-sm font-medium pb-4 px-2 whitespace-nowrap border-b-2 transition-colors', i === 0 ? 'border-[var(--color-fg,#111)]' : 'border-transparent text-[var(--color-muted-fg,#999)] hover:text-[var(--color-fg,#111)]']}
          data-tab-btn={i}
        >{tab.label}</button>
      ))}
    </div>
    {tabs.map((tab, i) => (
      <div class:list={['grid grid-cols-1 lg:grid-cols-2 gap-12 items-center', i > 0 ? 'hidden' : '']} data-tab-panel={i}>
        <div>
          <h3 class="text-2xl md:text-3xl font-semibold">{tab.title}</h3>
          <p class="mt-4 text-[var(--color-muted-fg,#666)] leading-relaxed text-lg">{tab.description}</p>
          {tab.features && (
            <ul class="mt-6 space-y-2">
              {tab.features.map((f) => (
                <li class="flex items-center gap-3 text-sm">
                  <svg class="w-4 h-4 flex-none text-[var(--color-primary,#111)]" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg>
                  {f}
                </li>
              ))}
            </ul>
          )}
        </div>
        {tab.image && <img src={tab.image} alt="" class="w-full rounded-lg" loading="lazy" />}
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('[data-tab-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-tab-btn');
      document.querySelectorAll('[data-tab-btn]').forEach((b) => { b.classList.add('border-transparent','text-[var(--color-muted-fg,#999)]'); b.classList.remove('border-[var(--color-fg,#111)]'); });
      btn.classList.remove('border-transparent','text-[var(--color-muted-fg,#999)]'); btn.classList.add('border-[var(--color-fg,#111)]');
      document.querySelectorAll('[data-tab-panel]').forEach((p) => p.classList.add('hidden'));
      document.querySelector(`[data-tab-panel="${idx}"]`)?.classList.remove('hidden');
    });
  });
</script>
