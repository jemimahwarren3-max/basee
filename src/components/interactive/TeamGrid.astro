---
interface Props {
  title?: string;
  members: {
    name: string;
    role: string;
    image: string;
    bio?: string;
    socials?: { platform: string; url: string }[];
  }[];
}
const { title = 'Our Team', members } = Astro.props;
---

<section class="py-24 md:py-32" data-component="team-grid">
  <div class="container-site">
    {title && (
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-16">{title}</h2>
    )}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {members.map((m) => (
        <div class="text-center">
          <img
            src={m.image}
            alt={m.name}
            class="w-full aspect-square object-cover rounded-xl mb-4"
            loading="lazy"
          />
          <h3 class="font-semibold">{m.name}</h3>
          <p class="text-sm text-[var(--color-accent,#6366F1)]">{m.role}</p>
          {m.bio && <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)]">{m.bio}</p>}
          {m.socials && (
            <div class="mt-3 flex justify-center gap-3">
              {m.socials.map((s) => (
                <a
                  href={s.url}
                  class="text-xs text-[var(--color-muted-fg,#999)] hover:text-[var(--color-fg,#111)]"
                  target="_blank"
                  rel="noopener"
                >
                  {s.platform}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
