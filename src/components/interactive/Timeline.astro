---
interface Props {
  title?: string;
  events: { date: string; title: string; description: string; image?: string }[];
}
const { title, events } = Astro.props;
---

<section class="py-24 md:py-32" data-component="timeline">
  <div class="container-site">
    {title && (
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-16">{title}</h2>
    )}
    <div class="max-w-2xl mx-auto space-y-12">
      {events.map((e) => (
        <div class="flex gap-6">
          <div class="flex flex-col items-center">
            <div class="w-3 h-3 rounded-full bg-[var(--color-accent,#6366F1)] flex-none" />
            <div class="w-px flex-1 bg-[var(--color-border,#e5e5e5)]" />
          </div>
          <div class="pb-8">
            <span class="text-xs font-mono text-[var(--color-muted-fg,#999)]">{e.date}</span>
            <h3 class="text-lg font-semibold mt-1">{e.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)]">{e.description}</p>
            {e.image && (
              <img
                src={e.image}
                alt=""
                class="w-full aspect-video object-cover rounded-lg mt-4"
                loading="lazy"
              />
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
