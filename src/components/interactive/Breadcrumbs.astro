---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="py-4" aria-label="Breadcrumb" data-component="breadcrumbs">
  <div class="container-site">
    <ol class="flex items-center gap-2 text-sm">
      {items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span class="text-[var(--color-muted-fg,#ccc)]">/</span>}
          {item.href && i < items.length - 1 ? (
            <a
              href={item.href}
              class="text-[var(--color-muted-fg,#999)] hover:text-[var(--color-fg,#111)] transition-colors"
            >
              {item.label}
            </a>
          ) : (
            <span class="text-[var(--color-fg,#111)] font-medium">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
