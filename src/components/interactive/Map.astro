---
interface Props {
  title?: string;
  address: string;
  embedUrl: string;
  details?: { label: string; value: string }[];
}
const { title, address, embedUrl, details } = Astro.props;
---

<section class="py-24 md:py-32" data-component="map">
  <div class="container-site">
    {title && <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-8">{title}</h2>}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-2 aspect-video rounded-xl overflow-hidden">
        <iframe
          src={embedUrl}
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          allowfullscreen
          title="Map"
        />
      </div>
      <div>
        <p class="text-[var(--color-muted-fg,#666)]">{address}</p>
        {details && (
          <div class="mt-6 space-y-4">
            {details.map((d) => (
              <div>
                <span class="text-xs font-medium uppercase tracking-wider text-[var(--color-muted-fg,#999)]">
                  {d.label}
                </span>
                <p class="text-sm mt-1">{d.value}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
