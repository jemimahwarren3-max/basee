---
interface Props {
  title: string;
  subtitle?: string;
  features: { icon: string; title: string; description: string }[];
  columns?: 2 | 3 | 4;
}

const { title, subtitle, features, columns = 3 } = Astro.props;
const colClass = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' };
---

<section class="py-24 md:py-32" data-component="features-icons">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    </div>
    <div class:list={['grid grid-cols-1 gap-10', colClass[columns]]}>
      {features.map((f) => (
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-5 flex items-center justify-center rounded-xl bg-[var(--color-muted,#f5f5f5)] text-2xl">{f.icon}</div>
          <h3 class="font-semibold text-lg">{f.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)] leading-relaxed">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
