---
interface Props { title?: string; posts: { title: string; excerpt: string; image: string; date: string; href: string; category?: string }[] }
const { title = 'Latest Articles', posts } = Astro.props;
---
<section class="py-24 md:py-32" data-component="blog-preview">
  <div class="container-site">
    <div class="flex items-center justify-between mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h2>
      <a href="/blog" class="text-sm font-medium text-[var(--color-accent,#6366F1)]">View All</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map(p => (
        <a href={p.href} class="group">
          <div class="aspect-[3/2] overflow-hidden rounded-xl mb-4">
            <img src={p.image} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          {p.category && <span class="text-xs font-medium uppercase tracking-wider text-[var(--color-accent,#6366F1)]">{p.category}</span>}
          <h3 class="text-lg font-semibold mt-1 group-hover:text-[var(--color-accent,#6366F1)] transition-colors">{p.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-muted-fg,#666)] line-clamp-2">{p.excerpt}</p>
          <span class="mt-3 block text-xs text-[var(--color-muted-fg,#999)]">{p.date}</span>
        </a>
      ))}
    </div>
  </div>
</section>
