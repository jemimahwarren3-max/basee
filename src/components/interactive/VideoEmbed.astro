---
interface Props { title?: string; subtitle?: string; videoUrl: string; poster?: string; autoplay?: boolean }
const { title, subtitle, videoUrl, poster, autoplay = false } = Astro.props;
const isYoutube = videoUrl.includes('youtube') || videoUrl.includes('youtu.be');
const isVimeo = videoUrl.includes('vimeo');
---
<section class="py-24 md:py-32" data-component="video-embed">
  <div class="container-site">
    {(title || subtitle) && (
      <div class="text-center max-w-2xl mx-auto mb-12">
        {title && <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h2>}
        {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
      </div>
    )}
    <div class="aspect-video rounded-2xl overflow-hidden bg-black">
      {(isYoutube || isVimeo) ? (
        <iframe src={videoUrl} width="100%" height="100%" frameborder="0" allow="autoplay; fullscreen" allowfullscreen loading="lazy" title="Video" />
      ) : (
        <video src={videoUrl} poster={poster} controls autoplay={autoplay} muted={autoplay} class="w-full h-full object-cover" preload="none" />
      )}
    </div>
  </div>
</section>
