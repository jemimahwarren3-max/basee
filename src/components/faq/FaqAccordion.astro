---
interface Props {
  title: string;
  subtitle?: string;
  items: { question: string; answer: string }[];
}

const { title, subtitle, items } = Astro.props;
---

<section class="py-24 md:py-32" data-component="faq-accordion">
  <div class="container-site max-w-3xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    </div>
    <div class="divide-y divide-[var(--color-border,#e5e5e5)]">
      {items.map((item, i) => (
        <details class="group py-6" data-faq>
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="text-lg font-medium pr-8">{item.question}</h3>
            <svg class="w-5 h-5 flex-none text-[var(--color-muted-fg,#999)] group-open:rotate-45 transition-transform duration-200" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M10 4v12M4 10h12" />
            </svg>
          </summary>
          <p class="mt-4 text-[var(--color-muted-fg,#666)] leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
