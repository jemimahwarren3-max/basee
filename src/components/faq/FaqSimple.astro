---
interface Props { title?: string; faqs: { question: string; answer: string }[] }
const { title = 'FAQ', faqs } = Astro.props;
---
<section class="py-24 md:py-32" data-component="faq-simple">
  <div class="container-site max-w-3xl">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center mb-16">{title}</h2>
    <div class="space-y-8">
      {faqs.map(f => (
        <div>
          <h3 class="text-lg font-semibold">{f.question}</h3>
          <p class="mt-2 text-[var(--color-muted-fg,#666)] leading-relaxed">{f.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>
