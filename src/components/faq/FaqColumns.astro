---
interface Props {
  title: string;
  items: { question: string; answer: string }[];
}
const { title, items } = Astro.props;
const half = Math.ceil(items.length / 2);
---

<section class="py-24 md:py-32" data-component="faq-columns">
  <div class="container-site">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-16">{title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="space-y-8">
        {items.slice(0, half).map((i) => (
          <div>
            <h3 class="font-semibold text-lg">{i.question}</h3>
            <p class="mt-2 text-[var(--color-muted-fg,#666)] leading-relaxed">{i.answer}</p>
          </div>
        ))}
      </div>
      <div class="space-y-8">
        {items.slice(half).map((i) => (
          <div>
            <h3 class="font-semibold text-lg">{i.question}</h3>
            <p class="mt-2 text-[var(--color-muted-fg,#666)] leading-relaxed">{i.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
