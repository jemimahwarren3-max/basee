---
interface Props {
  images: { src: string; alt?: string; caption?: string }[];
}

const { images } = Astro.props;
---

<section class="py-24 md:py-32" data-component="gallery-editorial">
  <div class="container-site space-y-16 md:space-y-24">
    {images.map((img, i) => {
      const layouts = [
        'w-full',
        'w-4/5 ml-auto',
        'w-3/4',
        'w-5/6 mx-auto',
        'w-full max-w-4xl',
        'w-4/5',
      ];
      return (
        <figure class:list={[layouts[i % layouts.length]]}>
          <img src={img.src} alt={img.alt || ''} class="w-full object-cover" loading="lazy" />
          {img.caption && (
            <figcaption class="mt-4 text-sm text-[var(--color-muted-fg,#888)] max-w-md">
              {img.caption}
            </figcaption>
          )}
        </figure>
      );
    })}
  </div>
</section>
