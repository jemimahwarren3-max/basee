---
interface Props {
  title?: string;
  images: { src: string; alt?: string; caption?: string }[];
  columns?: 2 | 3 | 4;
}

const { title, images, columns = 3 } = Astro.props;
const colClass = { 2: 'md:grid-cols-2', 3: 'sm:grid-cols-2 lg:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' };
---

<section class="py-24 md:py-32" data-component="gallery-grid">
  <div class="container-site">
    {title && <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-12">{title}</h2>}
    <div class:list={['grid grid-cols-1 gap-4', colClass[columns]]}>
      {images.map((img) => (
        <figure class="group overflow-hidden">
          <div class="overflow-hidden">
            <img src={img.src} alt={img.alt || ''} class="w-full aspect-[4/3] object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
          </div>
          {img.caption && <figcaption class="mt-3 text-sm text-[var(--color-muted-fg,#888)]">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>
