---
interface Props { images: { src: string; alt?: string }[]; columns?: 2 | 3 | 4 }
const { images, columns = 3 } = Astro.props;
const colClass = { 2: 'grid-cols-1 sm:grid-cols-2', 3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3', 4: 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4' };
---
<section class="py-24 md:py-32" data-component="gallery-minimal">
  <div class="container-site">
    <div class:list={['grid gap-1', colClass[columns]]}>
      {images.map(img => <img src={img.src} alt={img.alt || ''} class="w-full aspect-square object-cover" loading="lazy" />)}
    </div>
  </div>
</section>
