---
interface Props {
  images: { src: string; alt?: string; caption?: string }[];
}
const { images } = Astro.props;
---

<section class="py-24 md:py-32" data-component="gallery-carousel">
  <div class="overflow-hidden">
    <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none px-[var(--gutter,1.5rem)]">
      {images.map((img) => (
        <div class="flex-none w-[80vw] md:w-[45vw] lg:w-[35vw] snap-center">
          <img
            src={img.src}
            alt={img.alt || ''}
            class="w-full aspect-[3/4] object-cover rounded-xl"
            loading="lazy"
          />
          {img.caption && (
            <p class="mt-3 text-sm text-[var(--color-muted-fg,#999)]">{img.caption}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
