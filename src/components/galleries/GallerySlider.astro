---
interface Props {
  images: { src: string; alt?: string; caption?: string }[];
}
const { images } = Astro.props;
---

<section class="py-24 md:py-32" data-component="gallery-slider">
  <div class="overflow-hidden">
    <div
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory px-[var(--spacing-gutter)] pb-4"
      style="scrollbar-width:none;"
    >
      {images.map((img) => (
        <figure class="flex-none w-[70vw] md:w-[45vw] lg:w-[35vw] snap-center">
          <img
            src={img.src}
            alt={img.alt || ''}
            class="w-full aspect-[3/4] object-cover"
            loading="lazy"
          />
          {img.caption && (
            <figcaption class="mt-3 text-sm text-[var(--color-muted-fg,#888)]">
              {img.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </div>
</section>
