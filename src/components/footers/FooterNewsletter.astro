---
interface Props { brand: string; description?: string; columns: { title: string; links: { label: string; href: string }[] }[]; newsletterTitle?: string; copyright?: string }
const { brand, description, columns, newsletterTitle = 'Stay Updated', copyright } = Astro.props;
---
<footer class="bg-[var(--color-surface,#f9f9f9)] pt-20 pb-8" data-component="footer-newsletter">
  <div class="container-site">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-16">
      <div>
        <a href="/" class="text-xl font-bold">{brand}</a>
        {description && <p class="mt-4 text-sm text-[var(--color-muted-fg,#666)] max-w-sm">{description}</p>}
        <div class="mt-8 grid grid-cols-2 gap-8">
          {columns.map(col => (
            <div>
              <h4 class="text-sm font-semibold mb-3">{col.title}</h4>
              <ul class="space-y-2">{col.links.map(l => <li><a href={l.href} class="text-sm text-[var(--color-muted-fg,#666)] hover:text-[var(--color-fg,#111)] transition-colors">{l.label}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <div class="md:max-w-sm md:ml-auto">
        <h4 class="text-lg font-semibold">{newsletterTitle}</h4>
        <form class="mt-4 flex gap-2" data-newsletter>
          <input type="email" required placeholder="Email address" class="flex-1 px-4 py-2.5 border border-[var(--color-border,#e5e5e5)] rounded-md text-sm bg-[var(--color-bg,#fff)]" />
          <button type="submit" class="px-5 py-2.5 bg-[var(--color-fg,#111)] text-[var(--color-bg,#fff)] text-sm font-medium rounded-md">Subscribe</button>
        </form>
      </div>
    </div>
    <div class="border-t border-[var(--color-border,#e5e5e5)] pt-8 text-xs text-[var(--color-muted-fg,#999)]">{copyright || `© ${new Date().getFullYear()} ${brand}. All rights reserved.`}</div>
  </div>
</footer>
