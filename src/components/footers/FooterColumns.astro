---
interface Props {
  brand: string;
  description?: string;
  columns: { title: string; links: { label: string; href: string }[] }[];
  socials?: { label: string; href: string }[];
  copyright?: string;
}

const { brand, description, columns, socials = [], copyright } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="py-20 md:py-24 bg-[var(--color-dark-bg,#0a0a0a)] text-[var(--color-dark-fg,#fff)]" data-component="footer-columns">
  <div class="container-site">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      <div class="md:col-span-4">
        <a href="/" class="text-xl font-semibold">{brand}</a>
        {description && <p class="mt-4 text-sm text-white/70 leading-relaxed max-w-sm">{description}</p>}
        {socials.length > 0 && (
          <div class="mt-6 flex gap-4">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-sm text-white/70 hover:text-white transition-colors">
                {s.label}
              </a>
            ))}
          </div>
        )}
      </div>
      {columns.map((col) => (
        <div class="md:col-span-2">
          <h4 class="text-sm font-semibold uppercase tracking-widest mb-4">{col.title}</h4>
          <ul class="space-y-3">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/70 hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="pt-8 border-t border-white/10 text-sm text-white/70">
      {copyright || `© ${year} ${brand}. All rights reserved.`}
    </div>
  </div>
</footer>
