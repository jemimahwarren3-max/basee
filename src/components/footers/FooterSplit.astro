---
interface Props { brand: string; tagline?: string; columns: { title: string; links: { label: string; href: string }[] }[]; newsletter?: boolean }
const { brand, tagline, columns, newsletter = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="py-20 bg-[var(--color-fg,#0a0a0a)] text-white" data-component="footer-split">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
      <div class="lg:col-span-5">
        <a href="/" class="text-2xl font-semibold">{brand}</a>
        {tagline && <p class="mt-3 text-white/40 max-w-sm">{tagline}</p>}
        {newsletter && (
          <form class="mt-6 flex gap-2 max-w-sm">
            <input type="email" placeholder="Email" class="flex-1 px-4 py-2.5 bg-white/5 border border-white/10 text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-white/30" />
            <button class="px-5 py-2.5 bg-white text-black text-sm font-medium">Join</button>
          </form>
        )}
      </div>
      <div class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8">
        {columns.map((col) => (
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-widest text-white/50 mb-4">{col.title}</h4>
            <div class="space-y-2">{col.links.map((l) => <a href={l.href} class="block text-sm text-white/40 hover:text-white transition-colors">{l.label}</a>)}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="pt-8 border-t border-white/10 text-xs text-white/30">© {year} {brand}. All rights reserved.</div>
  </div>
</footer>
