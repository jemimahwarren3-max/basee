---
interface Props {
  brand: string;
  tagline?: string;
  links: { label: string; href: string }[];
  socials?: { label: string; href: string }[];
}
const { brand, tagline, links, socials = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="pt-24 pb-12 border-t border-[var(--color-border,#e5e5e5)]"
  data-component="footer-editorial"
>
  <div class="container-site">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <div>
        <a href="/" class="text-2xl font-semibold">
          {brand}
        </a>
        {tagline && (
          <p class="mt-4 text-[var(--color-muted-fg,#888)] max-w-sm leading-relaxed">{tagline}</p>
        )}
      </div>
      <div class="flex flex-col md:items-end gap-4">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-sm text-[var(--color-muted-fg,#888)] hover:text-[var(--color-fg,#111)] transition-colors"
          >
            {l.label}
          </a>
        ))}
      </div>
    </div>
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8 border-t border-[var(--color-border,#e5e5e5)]">
      <p class="text-sm text-[var(--color-muted-fg,#999)]">
        © {year} {brand}
      </p>
      {socials.length > 0 && (
        <div class="flex gap-4">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[var(--color-muted-fg,#999)] hover:text-[var(--color-fg,#111)] transition-colors"
            >
              {s.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</footer>
