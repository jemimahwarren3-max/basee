---
interface Props { brand: string; description?: string; links: { label: string; href: string }[]; email?: string; phone?: string; socials?: { label: string; href: string }[] }
const { brand, description, links, email, phone, socials = [] } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="py-20 bg-black text-white" data-component="footer-dark">
  <div class="container-site">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      <div>
        <a href="/" class="text-2xl font-semibold">{brand}</a>
        {description && <p class="mt-4 text-sm text-white/70 leading-relaxed">{description}</p>}
      </div>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest mb-4 text-white/60">Pages</h4>
        <div class="space-y-2">
          {links.map((l) => <a href={l.href} class="block text-sm text-white/70 hover:text-white transition-colors">{l.label}</a>)}
        </div>
      </div>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest mb-4 text-white/60">Contact</h4>
        {email && <p class="text-sm text-white/70"><a href={`mailto:${email}`} class="hover:text-white transition-colors">{email}</a></p>}
        {phone && <p class="text-sm text-white/70 mt-2"><a href={`tel:${phone}`} class="hover:text-white transition-colors">{phone}</a></p>}
        {socials.length > 0 && (
          <div class="mt-4 flex gap-4">
            {socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-sm text-white/70 hover:text-white transition-colors">{s.label}</a>)}
          </div>
        )}
      </div>
    </div>
    <div class="pt-8 border-t border-white/10 text-xs text-white/70">© {year} {brand}</div>
  </div>
</footer>
