---
interface Props {
  brand: string;
  links?: { label: string; href: string }[];
  socials?: { label: string; href: string }[];
  copyright?: string;
}

const { brand, links = [], socials = [], copyright } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="py-16 border-t border-[var(--color-border,#e5e5e5)]" data-component="footer-minimal">
  <div class="container-site flex flex-col md:flex-row items-center justify-between gap-6">
    <a href="/" class="text-lg font-semibold">
      {brand}
    </a>
    {links.length > 0 && (
      <nav class="flex items-center gap-6">
        {links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-[var(--color-muted-fg,#888)] hover:text-[var(--color-fg,#111)] transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    )}
    <p class="text-sm text-[var(--color-muted-fg,#999)]">{copyright || `© ${year} ${brand}`}</p>
  </div>
</footer>
