---
interface Props { brand: string; tagline?: string; socials?: { platform: string; url: string }[]; copyright?: string }
const { brand, tagline, socials, copyright } = Astro.props;
---
<footer class="py-24 bg-[var(--color-dark-bg,#111)]" data-component="footer-brand">
  <div class="container-site text-center">
    <a href="/" class="text-4xl md:text-6xl font-bold text-white tracking-tight">{brand}</a>
    {tagline && <p class="mt-4 text-white/50">{tagline}</p>}
    {socials && (
      <div class="mt-8 flex justify-center gap-6">
        {socials.map(s => <a href={s.url} class="text-sm text-white/70 hover:text-white transition-colors" target="_blank" rel="noopener">{s.platform}</a>)}
      </div>
    )}
    <p class="mt-12 text-xs text-white/60">{copyright || `© ${new Date().getFullYear()} ${brand}`}</p>
  </div>
</footer>
