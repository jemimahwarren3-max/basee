---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  cta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  badge?: string;
}

const { title, subtitle, image, cta, secondaryCta, badge } = Astro.props;
---

<section class="pt-32 pb-16 md:pt-40 md:pb-24" data-component="hero-product">
  <div class="container-site text-center">
    {badge && (
      <span class="inline-block text-xs font-medium uppercase tracking-[0.15em] px-4 py-1.5 rounded-full bg-[var(--color-muted,#f5f5f5)] text-[var(--color-muted-fg,#666)] mb-6">
        {badge}
      </span>
    )}
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.1] tracking-tight max-w-3xl mx-auto">
      <Fragment set:html={title} />
    </h1>
    {subtitle && (
      <p class="mt-6 text-lg text-[var(--color-muted-fg,#666)] max-w-xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    )}
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      {cta && (
        <a
          href={cta.href}
          class="px-8 py-3.5 bg-[var(--color-primary,#111)] text-white text-sm font-medium rounded-lg hover:opacity-90 transition-opacity"
        >
          {cta.label}
        </a>
      )}
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="px-8 py-3.5 text-sm font-medium text-[var(--color-fg,#111)] hover:opacity-70 transition-opacity"
        >
          {secondaryCta.label} →
        </a>
      )}
    </div>
  </div>
  <div class="mt-16 container-site">
    <img src={image} alt="" class="w-full rounded-xl shadow-2xl" loading="eager" />
  </div>
</section>
