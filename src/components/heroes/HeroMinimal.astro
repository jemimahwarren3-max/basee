---
interface Props {
  title: string;
  subtitle?: string;
  cta?: { label: string; href: string };
}

const { title, subtitle, cta } = Astro.props;
---

<section class="min-h-[80vh] flex items-center justify-center text-center" data-component="hero-minimal">
  <div class="container-site py-32">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.1] tracking-tight max-w-3xl mx-auto">
      <Fragment set:html={title} />
    </h1>
    {subtitle && (
      <p class="mt-6 text-lg md:text-xl text-[var(--color-muted-fg,#666)] max-w-xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    )}
    {cta && (
      <a href={cta.href} class="mt-8 inline-block px-8 py-3.5 bg-[var(--color-primary,#111)] text-[var(--color-bg,#fff)] text-sm font-medium hover:opacity-90 transition-opacity rounded-md">
        {cta.label}
      </a>
    )}
  </div>
</section>
