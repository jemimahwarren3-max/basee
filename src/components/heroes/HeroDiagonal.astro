---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  cta?: { label: string; href: string };
}
const { title, subtitle, image, cta } = Astro.props;
---

<section
  class="relative overflow-hidden bg-[var(--color-dark-bg,#111)] py-32 md:py-44"
  data-component="hero-diagonal"
>
  <div class="container-site relative z-10 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight">{title}</h1>
      {subtitle && <p class="mt-6 text-lg text-white/60">{subtitle}</p>}
      {cta && (
        <a
          href={cta.href}
          class="mt-8 inline-flex px-8 py-3 bg-[var(--color-accent,#6366F1)] text-white font-medium rounded-md"
        >
          {cta.label}
        </a>
      )}
    </div>
    <div class="relative">
      <div class="absolute -inset-4 bg-[var(--color-accent,#6366F1)]/20 -rotate-3 rounded-2xl" />
      <img src={image} alt="" class="relative w-full aspect-[4/3] object-cover rounded-xl" />
    </div>
  </div>
  <div
    class="absolute bottom-0 left-0 right-0 h-24 bg-[var(--color-bg,#fff)]"
    style="clip-path: polygon(0 100%, 100% 0, 100% 100%)"
  />
</section>
