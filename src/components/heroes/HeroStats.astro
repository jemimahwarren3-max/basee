---
interface Props { title: string; subtitle?: string; stats: { value: string; label: string }[]; cta?: { label: string; href: string } }
const { title, subtitle, stats, cta } = Astro.props;
---
<section class="py-32 md:py-44 bg-[var(--color-fg,#111)]" data-component="hero-stats">
  <div class="container-site text-center">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white leading-tight">{title}</h1>
    {subtitle && <p class="mt-6 text-lg text-white/60 max-w-2xl mx-auto">{subtitle}</p>}
    {cta && <a href={cta.href} class="mt-8 inline-flex px-8 py-3 bg-white text-[var(--color-fg,#111)] font-medium rounded-md">{cta.label}</a>}
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8 border-t border-white/10 pt-12">
      {stats.map(s => (
        <div>
          <p class="text-3xl md:text-4xl font-bold text-white">{s.value}</p>
          <p class="mt-2 text-sm text-white/50 uppercase tracking-wider">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
