---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  secondaryImage?: string;
  cta?: { label: string; href: string };
}

const { title, subtitle, image, secondaryImage, cta } = Astro.props;
---

<section class="min-h-screen pt-32 pb-16 overflow-hidden" data-component="hero-asymmetric">
  <div class="container-site">
    <div class="grid grid-cols-12 gap-6 items-end">
      <div class="col-span-12 lg:col-span-5 pb-12 lg:pb-24">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight">
          <Fragment set:html={title} />
        </h1>
        {subtitle && (
          <p class="mt-6 text-lg text-[var(--color-muted-fg,#666)] leading-relaxed max-w-md">
            {subtitle}
          </p>
        )}
        {cta && (
          <a
            href={cta.href}
            class="mt-8 inline-block text-sm uppercase tracking-[0.1em] font-medium border border-current px-8 py-4 hover:bg-[var(--color-dark-bg,#111)] hover:text-[var(--color-dark-fg,#fff)] transition-all"
          >
            {cta.label}
          </a>
        )}
      </div>

      <div class="col-span-12 lg:col-span-7 relative">
        <img src={image} alt="" class="w-full h-[60vh] lg:h-[80vh] object-cover" loading="eager" />
        {secondaryImage && (
          <img
            src={secondaryImage}
            alt=""
            class="hidden lg:block absolute -bottom-12 -left-24 w-64 h-80 object-cover shadow-2xl"
            loading="eager"
          />
        )}
      </div>
    </div>
  </div>
</section>
