---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  cta?: { label: string; href: string };
}

const { title, subtitle, image, cta } = Astro.props;
---

<section class="pt-32 pb-16 md:pt-40 md:pb-20 text-center" data-component="hero-centered-image">
  <div class="container-site">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.1] tracking-tight max-w-3xl mx-auto">{title}</h1>
    {subtitle && <p class="mt-5 text-lg text-[var(--color-muted-fg,#666)] max-w-lg mx-auto">{subtitle}</p>}
    {cta && (
      <a href={cta.href} class="mt-8 inline-block px-8 py-3 bg-[var(--color-primary,#111)] text-[var(--color-bg,#fff)] text-sm font-medium rounded-lg hover:opacity-90 transition-opacity">{cta.label}</a>
    )}
    <img src={image} alt="" class="mt-16 w-full max-w-4xl mx-auto rounded-xl shadow-xl" loading="eager" />
  </div>
</section>
