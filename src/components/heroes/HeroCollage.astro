---
interface Props {
  title: string;
  subtitle?: string;
  images: string[];
  cta?: { label: string; href: string };
}

const { title, subtitle, images, cta } = Astro.props;
---

<section class="pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden" data-component="hero-collage">
  <div class="container-site">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-light leading-[1.1] tracking-tight max-w-3xl">
      {title}
    </h1>
    {subtitle && <p class="mt-6 text-lg text-[var(--color-muted-fg,#666)] max-w-lg">{subtitle}</p>}
    {cta && (
      <a
        href={cta.href}
        class="mt-8 inline-block text-sm uppercase tracking-widest border-b border-current pb-1 hover:opacity-70 transition-opacity"
      >
        {cta.label}
      </a>
    )}
  </div>
  <div class="mt-16 grid grid-cols-12 gap-3 px-4">
    {images[0] && (
      <div class="col-span-7">
        <img src={images[0]} alt="" class="w-full aspect-[4/3] object-cover" loading="eager" />
      </div>
    )}
    {images[1] && (
      <div class="col-span-5 mt-12">
        <img src={images[1]} alt="" class="w-full aspect-[3/4] object-cover" loading="eager" />
      </div>
    )}
    {images[2] && (
      <div class="col-span-4 -mt-8">
        <img src={images[2]} alt="" class="w-full aspect-square object-cover" loading="lazy" />
      </div>
    )}
    {images[3] && (
      <div class="col-span-8">
        <img src={images[3]} alt="" class="w-full aspect-[16/9] object-cover" loading="lazy" />
      </div>
    )}
  </div>
</section>
