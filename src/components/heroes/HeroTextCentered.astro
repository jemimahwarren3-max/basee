---
interface Props {
  title: string;
  subtitle?: string;
  cta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { title, subtitle, cta, secondaryCta } = Astro.props;
---

<section class="pt-40 pb-24 md:pt-52 md:pb-32 text-center" data-component="hero-text-centered">
  <div class="container-site max-w-4xl">
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold leading-[1.1] tracking-tight">
      <Fragment set:html={title} />
    </h1>
    {subtitle && <p class="mt-6 text-lg md:text-xl text-[var(--color-muted-fg,#666)] max-w-2xl mx-auto leading-relaxed">{subtitle}</p>}
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      {cta && (
        <a href={cta.href} class="px-8 py-3.5 bg-[var(--color-primary,#111)] text-[var(--color-dark-fg,#fff)] text-sm font-medium hover:opacity-90 transition-opacity">{cta.label}</a>
      )}
      {secondaryCta && (
        <a href={secondaryCta.href} class="text-sm font-medium hover:opacity-70 transition-opacity">{secondaryCta.label} →</a>
      )}
    </div>
  </div>
</section>
