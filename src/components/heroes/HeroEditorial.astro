---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  tag?: string;
  cta?: { label: string; href: string };
}

const { title, subtitle, image, tag, cta } = Astro.props;
---

<section class="pt-32 pb-16 md:pt-40 md:pb-24" data-component="hero-editorial">
  <div class="container-site">
    {tag && (
      <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-muted-fg,#888)] mb-6 block">
        {tag}
      </span>
    )}
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-light leading-[1.05] tracking-tight max-w-5xl">
      <Fragment set:html={title} />
    </h1>
    {subtitle && (
      <p class="mt-8 text-xl text-[var(--color-muted-fg,#666)] max-w-xl leading-relaxed">
        {subtitle}
      </p>
    )}
    {cta && (
      <a href={cta.href} class="mt-8 inline-block text-sm uppercase tracking-[0.15em] border-b border-current pb-1 hover:opacity-70 transition-opacity">
        {cta.label}
      </a>
    )}
  </div>
  <div class="mt-16 md:mt-24">
    <img
      src={image}
      alt=""
      class="w-full h-[50vh] md:h-[70vh] object-cover"
      loading="eager"
    />
  </div>
</section>
