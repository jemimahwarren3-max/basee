---
interface Props {
  slides: {
    image: string;
    title: string;
    subtitle?: string;
    cta?: { label: string; href: string };
  }[];
}
const { slides } = Astro.props;
---

<section class="relative h-screen overflow-hidden" data-component="hero-slider">
  {slides.map((s, i) => (
    <div
      class:list={['absolute inset-0 transition-opacity duration-700', i > 0 ? 'opacity-0' : '']}
      data-slide={i}
    >
      <img src={s.image} alt="" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/50" />
      <div class="relative h-full flex items-center container-site">
        <div class="max-w-2xl">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight">
            {s.title}
          </h1>
          {s.subtitle && <p class="mt-4 text-lg text-white/70">{s.subtitle}</p>}
          {s.cta && (
            <a
              href={s.cta.href}
              class="mt-8 inline-flex px-8 py-3 bg-white text-black font-medium rounded-md"
            >
              {s.cta.label}
            </a>
          )}
        </div>
      </div>
    </div>
  ))}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3">
    {slides.map((_, i) => (
      <button
        class:list={[
          'w-2 h-2 rounded-full transition-colors',
          i === 0 ? 'bg-white' : 'bg-white/40',
        ]}
        data-slide-dot={i}
        aria-label={`Slide ${i + 1}`}
      />
    ))}
  </div>
</section>
<script>
  let current = 0;
  const slides = document.querySelectorAll('[data-slide]');
  const dots = document.querySelectorAll('[data-slide-dot]');
  function go(n: number) {
    slides.forEach((s, i) => {
      (s as HTMLElement).style.opacity = i === n ? '1' : '0';
    });
    dots.forEach((d, i) => {
      d.classList.toggle('bg-white', i === n);
      d.classList.toggle('bg-white/40', i !== n);
    });
    current = n;
  }
  dots.forEach((d) =>
    d.addEventListener('click', () => go(Number(d.getAttribute('data-slide-dot')))),
  );
  setInterval(() => go((current + 1) % slides.length), 5000);
</script>
