---
interface Props {
  title: string;
  subtitle?: string;
  plans: {
    name: string;
    price: string;
    period?: string;
    description: string;
    features: string[];
    cta: { label: string; href: string };
    featured?: boolean;
  }[];
}

const { title, subtitle, plans } = Astro.props;
---

<section class="py-24 md:py-32" data-component="pricing-cards">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-muted-fg,#666)]">{subtitle}</p>}
    </div>
    <div class:list={['grid gap-8 mx-auto', plans.length <= 3 ? 'grid-cols-1 md:grid-cols-3 max-w-5xl' : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4 max-w-6xl']}>
      {plans.map((plan) => (
        <div class:list={[
          'relative p-8 md:p-10 border',
          plan.featured
            ? 'border-[var(--color-primary,#111)] bg-[var(--color-fg,#111)] text-[var(--color-bg,#fff)]'
            : 'border-[var(--color-border,#e5e5e5)]',
        ]}>
          {plan.featured && <span class="absolute -top-3 left-8 text-xs uppercase tracking-widest bg-[var(--color-fg,#111)] text-[var(--color-bg,#fff)] px-3 py-1">Popular</span>}
          <h3 class="text-lg font-semibold">{plan.name}</h3>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-4xl font-light">{plan.price}</span>
            {plan.period && <span class:list={['text-sm', plan.featured ? 'text-white/60' : 'text-[var(--color-muted-fg,#888)]']}>/{plan.period}</span>}
          </div>
          <p class:list={['mt-4 text-sm', plan.featured ? 'text-white/70' : 'text-[var(--color-muted-fg,#666)]']}>{plan.description}</p>
          <ul class="mt-8 space-y-3">
            {plan.features.map((f) => (
              <li class="flex items-start gap-3 text-sm">
                <svg class="w-4 h-4 mt-0.5 flex-none" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z" /></svg>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={plan.cta.href}
            class:list={[
              'mt-8 block text-center text-sm font-medium py-3 transition-opacity hover:opacity-90',
              plan.featured ? 'bg-white text-black' : 'bg-[var(--color-fg,#111)] text-[var(--color-bg,#fff)]',
            ]}
          >
            {plan.cta.label}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
