{
  "name": "yonah-website-engine",
  "type": "module",
  "version": "1.0.0",
  "description": "Premium website production engine — 20 design families, 150+ components, one brief to finished site",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit && npm run build && npm run lint",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "check-tools": "node scripts/check-tools.mjs",
    "registry": "node scripts/build-registry.mjs",
    "extract-frames": "node scripts/extract-frames.mjs",
    "optimise-images": "node scripts/optimise-images.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.513.0",
    "motion": "^14.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "oxlint": "^1.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
