# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Pexels (https://www.pexels.com/api/) - key issuance currently paused
PEXELS_API_KEY=

# Pixabay (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# Unsplash (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
